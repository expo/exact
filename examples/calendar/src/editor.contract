use Event, Guest from "./models.contract"
use Guests from "./device.contract"
style FieldLabel
  font-size=12 font-weight=500 color="-exact-secondary-label"
style DateField
  box-sizing="border-box" min-width=0 height=26 padding=0 border-width=0 border-radius=6 background-color="transparent" color="-exact-label" font-size=13
style ToolButton
  display="flex" flex-direction="row" align-items="center" justify-content="center" height=28 padding=0 border-width=0 border-radius=7 -exact-press-scale=0.96
style FooterButton
  display="flex" flex-direction="row" align-items="center" justify-content="center" height=30 padding-top=0 padding-bottom=0 padding-left=14 padding-right=14 border-radius=7 -exact-press-scale=0.97


// Swatches are stored schedule colours; their checkmark stays dark on the pastels.
component ColorChoice
  props
    value: string
    label: string
    selected: string
    disabled: bool
    pick: action
  view
    button press=pick(value) disabled=disabled testId=`color-${label}` aria-label=label aria-selected=(selected == value) width=24 height=24 flex-shrink=0 padding=0 border-width=(selected == value ? 2 : 0) border-style="solid" border-color="-exact-background" box-shadow=(selected == value ? `0 0 0 2px ${value}` : "none") border-radius=12 background-color=value display="flex" align-items="center" justify-content="center" -exact-press-scale=0.94
      if selected == value
        text "✓" font-size=12 font-weight=700 color="#000000"


component KindTab
  props
    kind: string
    title: string
    selected: string
    disabled: bool
    ink: string
    muted: string
    surface: string
    pick: action
  view
    button testId=`kind-${kind}` press=pick(kind) role="radio" aria-checked=(selected == kind) disabled=disabled height=28 padding-left=12 padding-right=12 border-width=0 border-radius=7 background-color=(selected == kind ? surface : "transparent") box-shadow=(selected == kind ? "0 1px 2px rgba(28, 31, 44, 0.14)" : "none") display="flex" align-items="center" justify-content="center"
      text title font-size=13 font-weight=(selected == kind ? 600 : 500) color=(selected == kind ? ink : muted)

component Editor
  props
    editorOpen: bool
    compact: bool
    busy: bool
    editorReady: bool
    opening: bool
    libraryReady: bool
    allDay: bool
    confirmDelete: bool
    editorKind: string
    editorLabel: string
    editId: string
    title: string
    notes: string
    startDate: string
    endDate: string
    startTime: string
    endTime: string
    color: string
    error: string
    themeSurface: string
    themeInk: string
    themeMuted: string
    themeField: string
    themeBorder: string
    themeAccent: string
    themeAccentInk: string
    opened: Event
    setKind: action
    retryEvent: action
    writeTitle: action
    save: action
    editorKey: action
    writeNotes: action
    toggleAllDay: action
    writeStartDate: action
    writeStartTime: action
    writeEndDate: action
    writeEndTime: action
    pickColor: action
    keepEvent: action
    remove: action
    askDelete: action
    closeEditor: action
    guests: Guest[]
    canInvite: bool
    canAdd: bool
    calendarNote: string
    invite: action
    addToCalendar: action
    canEmail: bool
    canText: bool
    emailGuests: action
    textGuests: action
  view
    if editorOpen
      column navigationKey="editor" navigationPresentation="modal" navigationScroll="editor-fields" id="schedule-editor" testId=(editorKind == "todo" ? "todo-editor" : "schedule-editor") aria-label=editorLabel width=(compact ? "100%" : "30rem") height="min(38rem, 100%)" min-height=0 box-sizing="border-box" background-color=themeSurface overflow="hidden"
        header height=56 display="flex" flex-shrink=0 box-sizing="border-box" padding-left=24 padding-right=20 align-items="center" gap=12
          text editorLabel role="heading" aria-level=2 testId="editor-title" flex=1 min-width=0 font-size=16 font-weight=600 color=themeInk white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
        scroll id="editor-fields" testId="editor-fields" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain"
          column padding-left=24 padding-right=24 padding-top=2 padding-bottom=18 gap=14
            if editId == ""
              row testId="kind-tabs" role="radiogroup" aria-label="Item kind" height=32 flex-shrink=0 box-sizing="border-box" padding=2 gap=2 border-radius=9 background-color=themeField align-items="center"
                KindTab(kind="event", title="Event", selected=editorKind, disabled=busy, ink=themeInk, muted=themeMuted, surface=themeSurface, pick=setKind)
                KindTab(kind="plan", title="Plan", selected=editorKind, disabled=busy, ink=themeInk, muted=themeMuted, surface=themeSurface, pick=setKind)
                KindTab(kind="todo", title="Todo", selected=editorKind, disabled=busy, ink=themeInk, muted=themeMuted, surface=themeSurface, pick=setKind)
            if not editorReady
              text (opening ? "Opening…" : opened.message) color="-exact-system-red" font-size=13 testId="event-error"
              if opened.message != "" and not opening
                button press=retryEvent disabled=busy testId="retry-event" class=FooterButton align-self="flex-start" border-width=0 background-color=themeField
                  text "Try again" font-size=13 color=themeMuted
            input appearance="none" id="schedule-title" testId="schedule-title" aria-label="Title" placeholder=(editorKind == "todo" ? "What needs doing?" : "What are you planning?") value=title input=writeTitle submit=save key=editorKey disabled=(busy or not editorReady) width="100%" height=40 box-sizing="border-box" padding=0 border-width=0 background-color="transparent" font-size=22 font-weight=600 letter-spacing=-0.3 color=themeInk
            textarea appearance="none" id="schedule-notes" testId="schedule-notes" aria-label="Notes" placeholder="Add a description…" value=notes input=writeNotes disabled=(busy or not editorReady) width="100%" height=60 min-height=60 box-sizing="border-box" padding=0 font-size=13 font-family="system-ui" line-height="19px" border-width=0 background-color="transparent" color=themeInk
            column border-style="solid" border-top-width=1 border-right-width=0 border-bottom-width=1 border-left-width=0 border-color=themeBorder
              if editorKind != "todo"
                row align-items="center" gap=8 height=40
                  text "All day" flex=1 font-size=13 color=themeInk
                  input type="checkbox" switch checked=allDay change=toggleAllDay disabled=(busy or not editorReady) testId="all-day" aria-label="All day" accent-color=themeAccent
                box height=1 background-color=themeBorder
              row align-items="center" gap=8 height=40
                text (editorKind == "todo" ? "Date" : "Starts") flex=1 min-width=0 font-size=13 color=themeInk
                input type="date" id="start-date" testId="start-date" aria-label=(editorKind == "todo" ? "Todo date" : "Start date") value=startDate input=writeStartDate disabled=(busy or not editorReady) class=DateField width=128 color=themeInk min="1900-01-01" max="2100-12-31"
                if editorKind != "todo" and not allDay
                  input type="time" id="start-time" testId="start-time" aria-label="Start time" value=startTime input=writeStartTime disabled=(busy or not editorReady) class=DateField width=88 color=themeInk
              if editorKind != "todo"
                box height=1 background-color=themeBorder
                row align-items="center" gap=8 height=40
                  text "Ends" flex=1 min-width=0 font-size=13 color=themeInk
                  input type="date" id="end-date" testId="end-date" aria-label="End date, included" value=endDate input=writeEndDate disabled=(busy or not editorReady) class=DateField width=128 color=themeInk min="1900-01-01" max="2100-12-31"
                  if not allDay
                    input type="time" id="end-time" testId="end-time" aria-label="End time" value=endTime input=writeEndTime disabled=(busy or not editorReady) class=DateField width=88 color=themeInk
            row gap=12 align-items="center"
              text "Color" class=FieldLabel color=themeMuted flex=1
              ColorChoice(value="#FA7070", label="Coral", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              ColorChoice(value="#747AFF", label="Blue", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              ColorChoice(value="#70B8A2", label="Mint", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              ColorChoice(value="#F39B65", label="Honey", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              ColorChoice(value="#D4BEF1", label="Lilac", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              ColorChoice(value="#EE8192", label="Rose", selected=color, disabled=(busy or not editorReady), pick=pickColor)
            if editId != "" and editorKind != "todo" and (canInvite or canAdd or guests.length > 0)
              Guests(guests=guests, canInvite=canInvite, canAdd=canAdd, note=calendarNote, disabled=(busy or not editorReady), ink=themeInk, muted=themeMuted, invite=invite, addToCalendar=addToCalendar, canEmail=canEmail, canText=canText, emailGuests=emailGuests, textGuests=textGuests)
            if error != ""
              text error testId="editor-error" aria-live="assertive" font-size=13 color="-exact-system-red" padding=10 border-radius=8 background-color=themeField
        row testId="editor-footer" height=56 flex-shrink=0 box-sizing="border-box" padding-left=20 padding-right=20 align-items="center" gap=8 border-style="solid" border-top-width=1 border-right-width=0 border-bottom-width=0 border-left-width=0 border-color=themeBorder
          if confirmDelete
            text (editorKind == "todo" ? "Delete this todo?" : "Delete this item from every date?") testId="delete-question" flex=1 min-width=0 font-size=13 font-weight=500 color="-exact-system-red" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
            button press=keepEvent disabled=busy testId="keep-schedule" class=FooterButton border-width=1 border-style="solid" border-color=themeBorder background-color=themeSurface
              text "Keep" font-size=13 font-weight=500 color=themeInk
            button press=remove disabled=busy testId="confirm-delete" class=FooterButton border-width=0 background-color="light-dark(#b3261e, #ffb4ab)"
              text (busy ? "Deleting…" : "Delete") font-size=13 font-weight=600 color=themeAccentInk
          else
            if editId != ""
              button press=askDelete disabled=(busy or not editorReady) testId="delete-schedule" class=FooterButton padding-left=8 padding-right=8 border-width=0 background-color="transparent"
                text (editorKind == "todo" ? "Delete Todo…" : "Delete…") font-size=13 font-weight=500 color="-exact-system-red"
            box flex=1
          button id="cancel-editor" press=closeEditor testId="cancel-editor" aria-label="Cancel editing" aria-keyshortcuts="Escape" disabled=busy class=FooterButton border-width=1 border-style="solid" border-color=themeBorder background-color=themeSurface
            text "Cancel" font-size=13 font-weight=500 color=themeInk
          if not confirmDelete
            button press=save testId="save-schedule" aria-label=(editId != "" ? "Save item" : "Add item") disabled=(busy or not libraryReady or not editorReady or title == "") class=FooterButton border-width=0 background-color=(busy or title == "" ? themeBorder : themeAccent)
              text (busy ? "Saving…" : (editId != "" ? "Save" : "Add")) font-size=13 font-weight=600 color=(busy or title == "" ? themeMuted : themeAccentInk)
