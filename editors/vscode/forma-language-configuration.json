{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "folding": { "offSide": true },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:axes|dials|theme|icons|exports|params)\\s*|(?:component)\\s+\\S+.*)(?://.*)?$"
  }
}
