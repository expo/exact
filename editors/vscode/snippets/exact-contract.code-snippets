{
  "Component": {
    "prefix": "component",
    "body": [
      "component ${1:Name}",
      "  props",
      "    ${2:title}: ${3:string}",
      "  view",
      "    column",
      "      text ${2:title}$0"
    ],
    "description": "Declare a Contract component"
  },
  "Shape": {
    "prefix": "shape",
    "body": [
      "shape ${1:Name}",
      "  ${2:id}: ${3:string}",
      "  $0"
    ],
    "description": "Declare a closed record shape"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:x}: ${3:number}): ${4:string} = $0"
    ],
    "description": "Declare a pure inline function"
  },
  "Style": {
    "prefix": "style",
    "body": [
      "style ${1:Name}",
      "  ${2:padding=12}$0"
    ],
    "description": "Declare a named style"
  },
  "Keyframes": {
    "prefix": "keyframes",
    "body": [
      "keyframes ${1:FadeIn}",
      "  from opacity=0",
      "  to opacity=1$0"
    ],
    "description": "Declare CSS keyframes"
  },
  "Routes": {
    "prefix": "routes",
    "body": [
      "routes ${1:nav}",
      "  tab ${2:home} \"/\"",
      "  notfound$0"
    ],
    "description": "Declare a route table"
  },
  "Resource": {
    "prefix": "resource",
    "body": [
      "resource ${1:items} = ${2:loadItems}() as shape ${3:Item}[] else empty()$0"
    ],
    "description": "Declare an async data resource"
  },
  "Resource For": {
    "prefix": "resource-for",
    "body": [
      "resource ${1:details} = ${2:loadDetail}(${3:item}.id) for ${3:item} in ${4:items} key=${3:item}.id as shape ${5:Detail}$0"
    ],
    "description": "Declare a per-item list resource"
  },
  "Mutation": {
    "prefix": "mutation",
    "body": [
      "mutation ${1:save} as shape ${2:Result} refreshes ${3:items}$0"
    ],
    "description": "Declare an async mutation slot"
  },
  "Action": {
    "prefix": "action",
    "body": [
      "action ${1:handle}(${2})",
      "  $0"
    ],
    "description": "Declare a component action"
  },
  "Task": {
    "prefix": "task",
    "body": [
      "task ${1:ticker} ${2|mount,when running|}",
      "  every(${3:1000}, ${4:tick})$0"
    ],
    "description": "Declare a timer task"
  },
  "For Loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} key=${1:item}.${3:id}",
      "  $0"
    ],
    "description": "Keyed list rendering"
  },
  "Option Match": {
    "prefix": "match",
    "body": [
      "match ${1:opt}",
      "  case some(${2:value})",
      "    $3",
      "  case none",
      "    $0"
    ],
    "description": "Exhaustive option match block"
  },
  "Inline Option Match": {
    "prefix": "match-inline",
    "body": [
      "match ${1:opt} { case some(${2:v}) => ${3:v}, case none => ${0:\"\"} }"
    ],
    "description": "Inline option match expression"
  },
  "Rotate Simulator": {
    "prefix": "rotate",
    "body": ["rotate ${1|portrait,portraitUpsideDown,landscapeLeft,landscapeRight|}"],
    "description": "Wait for the iOS simulator scene to turn"
  },
  "Test": {
    "prefix": "test",
    "body": [
      "test \"${1:name}\"",
      "  expect text \"${2:testId}\" == \"${0:Hello}\""
    ],
    "description": "Authored Contract end-to-end test"
  }
}
