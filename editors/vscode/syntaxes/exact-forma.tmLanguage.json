{
  "name": "Exact Forma",
  "scopeName": "source.exact-forma",
  "fileTypes": ["forma"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#colors" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "//.*$", "name": "comment.line.double-slash.exact-forma" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.exact-forma",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            { "match": "\\\\.", "name": "constant.character.escape.exact-forma" }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^(forma|component)\\s+([A-Za-z_][A-Za-z0-9_.-]*)",
          "captures": {
            "1": { "name": "keyword.declaration.exact-forma" },
            "2": { "name": "entity.name.type.exact-forma" }
          }
        },
        {
          "match": "^(axes|dials|theme|icons|exports)\\s*(?://.*)?$",
          "captures": {
            "1": { "name": "keyword.declaration.exact-forma" }
          }
        },
        {
          "match": "^\\s+(params)\\s*(?://.*)?$",
          "captures": {
            "1": { "name": "keyword.declaration.exact-forma" }
          }
        },
        {
          "match": "^\\s+(when)\\s+",
          "captures": {
            "1": { "name": "keyword.control.exact-forma" }
          }
        },
        {
          "match": "^\\s+([A-Za-z_][A-Za-z0-9_.-]*)(?=\\s*[:=])",
          "captures": {
            "1": { "name": "variable.other.property.exact-forma" }
          }
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "match": "#(?:[0-9A-Fa-f]{8}|[0-9A-Fa-f]{6}|[0-9A-Fa-f]{4}|[0-9A-Fa-f]{3})(?![0-9A-Fa-fA-Za-z_])",
          "name": "constant.other.color.rgb-value.exact-forma"
        },
        {
          "match": "(?<![A-Za-z0-9_-])-exact-[A-Za-z][A-Za-z0-9-]*(?![A-Za-z0-9_-])",
          "name": "support.constant.color.exact-forma"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_-])(?:light-dark|oklch|oklab|color-mix|calc|rgb|rgba|hsl|hsla|icon|spring|cubic-bezier)(?=\\s*\\()",
          "name": "support.function.exact-forma"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_-])(?:color|length|number|type|box-shadow|text-shadow|duration|easing|spring)(?![A-Za-z0-9_-])",
          "name": "storage.type.exact-forma"
        },
        {
          "match": "(?<![A-Za-z0-9_-])(?:under|in|from|step|control|group|priority|label|options|scheme|fixed|sf|svg)(?![A-Za-z0-9_-])",
          "name": "keyword.control.exact-forma"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?:px|rem|em|ms|s|%|deg)?(?![A-Za-z0-9_])",
          "name": "constant.numeric.exact-forma"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "match": "\\.\\.|[=:|,+*/()-]", "name": "keyword.operator.exact-forma" }
      ]
    }
  }
}
