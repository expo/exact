// The inset rule (`kernel/src/kernel/context.rs`, InsetRuleIOSTests) in a
// route under a `viewport-fit="cover"` root: each case of the safe-area
// design's 2.1, picked by a press. `env(safe-area-inset-*)` in a route reads
// what its root leaves: 0 on the edges the route clears, the route's band on
// an edge its root ignores.
routes nav
  home "/"
    sheet "/sheet"

component InsetRuleRoute
  state arrangement = "list"
  action pick(name: string)
    arrangement = name
  action open
    nav = push(nav, "/sheet")
  derive envTop = "env(safe-area-inset-top)"
  derive ignoring = arrangement == "ignore-env" or arrangement == "ignore-max" or arrangement == "ignore-over"
  derive boxed = arrangement == "box-max" or ignoring
  derive boxPad = arrangement == "ignore-env" ? envTop : "max(16px, env(safe-area-inset-top))"
  derive rootPad = arrangement == "root-env" ? envTop : (arrangement == "root-max" ? "max(16px, env(safe-area-inset-top))" : "0px")
  derive barred = not (arrangement == "barless" or arrangement == "root-env" or arrangement == "root-max")
  derive rowPad = arrangement == "row-var" ? "var(--exact-safe-area-inset-top)" : (arrangement == "row-env" ? envTop : "0px")
  view
    main navigationKey=`${top(nav).id}` testId="app" viewport-fit="cover" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` testId="route" navigationBar=(barred ? "auto" : "none") navigationScroll="primary" position="absolute" inset=0 display="flex" flex-direction="column" padding-top=rootPad -exact-safe-area-ignore=(ignoring ? "container top" : "none")
            if barred
              header display="flex" align-items="center" padding="8px 16px"
                text "Home" role="heading" aria-level=1
            if arrangement == "barless"
              column testId="top-bar" flex-shrink=0 padding-top=envTop
                column testId="top-bar-content" height=52
            if boxed
              column testId="box" flex-shrink=0 padding-top=boxPad
                text "box" testId="box-content"
            row flex=1 min-height=0
              scroll id="primary" testId="primary" flex=1 min-height=0
                column padding-top=rowPad
                  text "first" testId="first"
                column height=2000
              if arrangement == "two"
                scroll testId="second" flex=1 min-height=0
                  text "second first" testId="second-first"
                  column height=2000
            if arrangement == "ignore-over"
              column testId="box" position="absolute" top=0 left=0 right=0 padding-top=envTop
                text "box" testId="box-content"
            column position="absolute" top="40%" right=0 width=8
              for name in ["list", "row-var", "row-env", "barless", "root-env", "root-max", "box-max", "ignore-env", "ignore-max", "ignore-over", "two"] key=name
                button press=pick(name) testId=`pick-${name}` aria-label=name width=8 height=8
              button press=open testId="open" aria-label="open" width=8 height=8
        if e.name == "sheet"
          column navigationKey=`${e.id}` testId="sheet" navigationPresentation="modal" navigationDetent="fit-content" navigationBar="none" display="flex" flex-direction="column" padding-bottom="env(safe-area-inset-bottom)"
            column testId="sheet-content" height=300
