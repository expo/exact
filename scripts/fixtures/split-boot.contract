// LLP 1127 D2: a barless root that asks for the split is the split's from
// the first frame, not a boot holder's (SplitIOSTests). Its list paints no
// cells (`appearance="none"`), so nothing else in the plan needs a native
// owner before the first frame.
routes nav
  library "/"
    book "/book/:id"

component App
  action follow(url: string)
    nav = go(nav, url)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "library"
          column navigationKey=`${e.id}` navigationBar="none" navigationSplit="split" position="absolute" inset=0 display="flex" flex-direction="column"
            list testId="books" appearance="none" flex=1 min-height=0
              for id in ["a", "b"] key=id
                link href=path("book", id) testId=`row-${id}`
                  text `Book ${id}`
        if e.name == "book"
          column navigationKey=`${e.id}` navigationBar="none" position="absolute" inset=0
            text `Book ${e.params.id}`
