// LLP 1127 D3: beside the detail, a split's list column shows UIKit's sidebar material under the grounds the compiler
// gives its route and every list in it, a list that is not the directory included, and a modal box under the
// directory's ground is painted over only while that ground paints (SplitIOSTests).
routes nav
  library "/"
    book "/book/:id"

component SplitGround
  action follow(url: string)
    nav = go(nav, url)
  view
    main navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "library"
          column navigationKey=`${e.id}` navigationSplit="split" position="absolute" inset=0 display="flex" flex-direction="column"
            header
              text "Library" role="heading" aria-level=1
            box aria-modal="true" testId="under" position="absolute" top=240 left=40 width=40 height=40
            list testId="books" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                for id in ["a", "b"] key=id
                  link href=path("book", id) testId=`row-${id}`
                    text `Book ${id}`
            list testId="shelves" appearance="auto" listStyle="inset-grouped" height=120
              section
                text "Shelf" testId="shelf"
        if e.name == "book"
          column navigationKey=`${e.id}` position="absolute" inset=0
            header
              text `Book ${e.params.id}` role="heading" aria-level=2
