// LLP 1127.000: one library visit owns its search, including when N1 covers it.
routes nav
  library "/"
    book "/book/:id"
    chapter "/chapter/:id"
    inspector "/inspector"
    sheet "/sheet"
    tip "/tip"

component App
  state query = ""
  state mode = ""
  state cancelCount = 0
  state emptyEdits = 0
  state backs = 0
  state refusedPresses = 0
  state resultPointers = 0
  state searchFocuses = 0
  state contactLifts = 0
  state contactPresses = 0
  state ownerVariant = 0
  state splits = true
  state keep = true
  state coverSearch = false
  state toolbarSearch = false
  state noAvoidance = false
  state detailSearch = false
  state pushResult = false
  state repeatResult = false
  state backMode = ""
  state widget = "resizes-content"
  derive target = mode == "ordinary" ? "" : (mode == "alternate" ? "alternate" : "found")
  derive resultsShown = mode == "suggestions" or (query.trim() != "" and mode != "hidden")
  action follow(url: string)
    if url == "/replace-chapter"
      nav = replace(nav, "/chapter/c")
    else if url == "/replace-book"
      nav = replace(nav, "/book/a")
    else if url == "/push-b"
      nav = push(nav, "/book/b")
    else if url == "/inspect"
      nav = push(nav, "/inspector")
    else if url == "/present"
      nav = push(nav, "/sheet")
    else if url == "/present-child"
      nav = push(push(nav, "/sheet"), "/tip")
    else if url == "/new-query"
      query = "newer"
    else if url == "/take-query"
      keep = false
    else if url == "/detail-search"
      detailSearch = true
    else if url == "/push-result"
      pushResult = true
    else if url == "/repeat-result"
      repeatResult = true
    else if ["/back-refuse", "/back-redirect", "/back-normal"].includes(url)
      backMode = url
    else if url == "/cover-search" or url == "/toolbar-search"
      coverSearch = true
      toolbarSearch = url == "/toolbar-search"
    else if url == "/none"
      noAvoidance = true
    else if url == "/overlays"
      noAvoidance = false
      widget = "overlays-content"
    else if url == "/visual"
      widget = "resizes-visual"
    else if url == "/layout"
      widget = "resizes-content"
      noAvoidance = false
    else if url == "/unsplit"
      splits = false
    else if url == "/replace-owner"
      ownerVariant = ownerVariant + 1
    else if ["/missing", "/hidden", "/ambiguous", "/alternate", "/suggestions", "/normal", "/ordinary", "/nested", "/ineligible", "/clearance"].includes(url)
      mode = url.slice(1)
    else
      nav = open(nav, url)
  action back
    backs = backs + 1
    if backMode == "/back-refuse"
      nav = select(nav, "unavailable")
    else if backMode == "/back-redirect"
      nav = open(nav, "/chapter/c")
    else
      nav = back(nav)
  action search(v: string)
    if v == ""
      emptyEdits = emptyEdits + 1
    query = v
  action cancel
    cancelCount = cancelCount + 1
    if keep
      preventDefault()
  action choose(url: string)
    if repeatResult
      nav = go(nav, url)
    else
      nav = pushResult ? push(nav, url) : open(nav, url)
  action chapter
    nav = push(nav, "/chapter/c")
  action refuse
    refusedPresses = refusedPresses + 1
    nav = select(nav, "unavailable")
  action resultPointer
    resultPointers = resultPointers + 1
  action searchFocus
    searchFocuses = searchFocuses + 1
  action liftContact
    contactLifts = contactLifts + 1
  action pressContact
    contactPresses = contactPresses + 1
  action startContact
    nav = open(nav, "/book/a")
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" viewport-fit=(toolbarSearch ? "cover" : "auto") interactive-widget=widget width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "library"
          for owner in [ownerVariant] key=owner
            column navigationKey=`${e.id}` navigationScroll="books" navigationSplit=(splits ? "auto" : "none") position="absolute" inset=0 display="flex" flex-direction="column" testId="library" pointerdown=resultPointer
              header
                text (coverSearch ? "" : "Library") role="heading" aria-level=(coverSearch ? 2 : 1)
                if detailSearch
                  input type="search" id="levels-search" value=query input=search cancel=cancel focus=searchFocus aria-controls=target searchResultsPlacement="detail" placeholder="Search" aria-label="Search" testId="search" searchStyle=(toolbarSearch ? "minimized" : "automatic")
                else
                  input type="search" id="levels-search" value=query input=search cancel=cancel focus=searchFocus aria-controls=target placeholder="Search" aria-label="Search" testId="search" searchStyle=(toolbarSearch ? "minimized" : "automatic")
              list id="books" testId="books" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  for id in ["a", "b"] key=id
                    link href=path("book", id) testId=`row-${id}`
                      text `Book ${id}`
                  link href=path("chapter", "c") testId="row-c"
                    text "Chapter c"
              if !["missing", "nested", "ineligible"].includes(mode)
                column id="found" display=(resultsShown ? "flex" : "none") flex-direction="column" flex=1 min-height=0 testId="results" keyboardAvoidance=(noAvoidance ? "none" : "auto")
                  if mode == "clearance"
                    scroll flex=1 min-height=0 testId="clearance-outer"
                      scroll height=640 flex-shrink=0 testId="clearance-inner"
                        for n in range(24) key=n
                          text `Result ${n}` min-height=48 testId=`clearance-row-${n}`
                  else
                    list appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 testId="results-list"
                      section
                        if mode == "suggestions"
                          button press=refuse testId="result-refused"
                            text "Unavailable"
                        for id in ["a", "b"] key=id
                          link href=path("book", id) press=choose(path("book", id)) testId=`result-${id}` min-height=52
                            text `Book ${id}`
                        for i in range(36) key=i
                          text `Other book ${i}` min-height=52 testId=`tail-${i}`
              if mode == "ambiguous" or mode == "alternate"
                column id=(mode == "ambiguous" ? "found" : "alternate") display="flex" testId="other-results"
                  button press=choose("/chapter/c") testId="other-result"
                    text "Chapter c"
              if mode == "nested"
                column
                  column id="found" testId="nested-results"
              if mode == "ineligible"
                text "Ineligible" id="found" testId="ineligible-results"
        if e.name == "book" or e.name == "chapter"
          for name in [e.name] key=name
            column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" testId=`${name}-${e.params.id}`
              header
                text `${name} ${e.params.id}` role="heading" aria-level=2
                button id="back" press=back aria-label="Back"
                  image "symbol:back"
              scroll flex=1 min-height=0 testId="detail-scroll"
                text "Reading"
                if detailSearch and e.name == "book"
                  button testId="push-chapter" press=chapter
                    text "Chapter"
                box tabindex=0 testId="held-contact" min-height=52 pointerup=liftContact press=pressContact
                  text "Hold"
                box tabindex=0 testId="contact-starts-route" min-height=52 pointerdown=startContact pointerup=liftContact press=pressContact
                  text "Open a book"
        if e.name == "inspector" or e.name == "sheet" or e.name == "tip"
          column navigationKey=`${e.id}` navigationPresentation=(e.name == "tip" ? "push" : "modal") navigationInspector=(e.name == "inspector") position="absolute" inset=0 testId=e.name
            header
              text e.name role="heading" aria-level=2
