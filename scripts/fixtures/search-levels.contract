// A list whose header's search names its results route by `aria-controls`: using the field enters the
// results, a level on top of the stack (`search`), before anything is typed. Collapsed, they are drawn in
// the list's controller, the field in its bar; expanded, they are the detail's, pushed over its page. A
// result pushes over them, and Back returns to them. The close button keeps the text (`preventDefault()`
// on `cancel`). The list is grouped, as UIKit pads a grouped list's top while its search is open.
// SearchLevelsIOSTests.
routes nav
  library "/"
    book "/book/:id"
    chapter "/chapter/:id"
    search "/search"

component App
  state query = ""
  action follow(url: string)
    nav = url == "/chapter/c" ? open(nav, url) : go(nav, url)
  action back
    nav = back(nav)
  action enterSearch
    nav = go(nav, "/search")
  action search(v: string)
    query = v
    if v.trim() != ""
      nav = go(nav, "/search")
  action keepQuery
    preventDefault()
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "library"
          column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" testId="library"
            header
              text "Library" role="heading" aria-level=1
              input type="search" id="levels-search" value=query input=search focus=enterSearch cancel=keepQuery aria-controls="found" placeholder="Search" testId="search"
            list testId="books" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                for id in ["a", "b"] key=id
                  link href=path("book", id) testId=`row-${id}`
                    text `Book ${id}`
                link href=path("chapter", "c") testId="row-c"
                  text "Chapter c"
        if e.name == "book"
          column navigationKey=`${e.id}` position="absolute" inset=0 testId=`book-${e.params.id}`
            header
              text `Book ${e.params.id}` role="heading" aria-level=2
        if e.name == "chapter"
          column navigationKey=`${e.id}` position="absolute" inset=0 testId="chapter"
            header
              text "Chapter" role="heading" aria-level=1
        if e.name == "search"
          column id="found" navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" testId="results"
            list testId="results-list" flex=1 min-height=0
              for id in ["a", "b"] key=id
                link href=path("book", id) testId=`result-${id}`
                  text `Book ${id} for ${query}`
