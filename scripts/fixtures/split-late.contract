// LLP 1127 D19, D22: a root route that says nothing about a split, whose
// list's rows come only with Fill (SplitIOSTests): an iPad outside a tab
// splits once the rows push, read again with that batch, and any other
// device keeps the stack pushed.
routes nav
  library "/"
    book "/book/:id"

component App
  state ids: string[] = []
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  action fill
    ids = ["a", "b"]
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "library"
          column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" testId="library"
            header
              text "Library" role="heading" aria-level=1
            button press=fill testId="fill"
              text "Fill"
            list testId="books" flex=1 min-height=0
              for id in ids key=id
                link href=path("book", id) testId=`row-${id}`
                  text `Book ${id}`
        if e.name == "book"
          column navigationKey=`${e.id}` position="absolute" inset=0
            text `Book ${e.params.id}` testId="book"
