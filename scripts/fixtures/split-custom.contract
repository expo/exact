routes nav
  home "/"
    detail "/detail"

component App
  state directory = false
  action customize
    directory = not directory
  action follow(url: string)
    nav = go(nav, url)
  view
    main navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationSplit="split" navigationBar="none" position="absolute" inset=0
            if directory
              list testId="directory" flex=1
                link href="/detail" testId="open"
                  text "Open detail"
            else
              link href="/detail" testId="custom-open"
                text "Open detail"
        else
          column navigationKey=`${e.id}` position="absolute" inset=0
            button press=customize testId="customize"
              text "Change primary"
