shape Counts
  n: number
  label: string
shape Data
  counts: Counts
component App
  resource data = fetchData(1) as shape Data
  resource other = fetchData(2) as shape Data
  derive inner = data.counts.n
  derive outer = inner + 1
  view
    column
      text `${outer}` testId="value"
      text `${other.counts.label} ${other.counts.n}` testId="other"
