// The conformance fixture (LLP 1133.001 D7, LLP 1133.019 §11): each name of
// @exact/photos, its answers shown by testId for the suite. The list is read
// once `read` is pressed; its first six photos are drawn as pictures, each
// counting its `load` and `error`. `read-all` and `read-all-2` read every
// page, 500 or 2 a page; `read-shots` and `read-shots-2` the screenshots
// alone (LLP 1133.019.000 D4); `watch` shows what changed since a token.
use photoLibraryStatus, photoChanges, copyPhotoAsset, addToPhotoLibrary, managePhotoSelection, PhotoLibraryStatus, PhotoAssetList, PhotoCopy, PhotoAdded, PhotoChanges from "@exact/photos"

// Every page of the list, read by following its cursors.
shape Paged
  pages: number
  count: number
  distinct: number
  ordered: bool
  marked: bool
  first: string

component Fixture
  state reading = false
  state pageSize = 0
  state shotSize = 0
  state watching = false
  state loads = 0
  state errors = 0
  state lastError = ""
  resource status = photoLibraryStatus() as shape PhotoLibraryStatus else empty()
  resource list = assets(reading) as shape PhotoAssetList else empty()
  resource all = everything(pageSize, false) as shape Paged else empty()
  resource shots = everything(shotSize, true) as shape Paged else empty()
  mutation copied as shape PhotoCopy
  mutation added as shape PhotoAdded
  mutation managed as shape PhotoLibraryStatus
  derive first = match list.assets.at(0) { case some(a) => a.id, case none => "" }
  derive copyError = match failure(copied) { case some(f) => f.code, case none => "" }
  derive addError = match failure(added) { case some(f) => f.code, case none => "" }
  derive manageError = match failure(managed) { case some(f) => f.code, case none => "" }
  action read
    reading = true
  action readAll(size: number)
    pageSize = size
  action readShots(size: number)
    shotSize = size
  action watch
    watching = true
  action copyFirst
    send copied = copyPhotoAsset(asset=first)
  action addCopy
    send added = addToPhotoLibrary(path=match copied { case some(c) => c.path, case none => "" })
  action manage
    send managed = managePhotoSelection()
  action loaded
    loads = loads + 1
  action failed(message: string)
    errors = errors + 1
    lastError = message
  view
    column gap=8 padding=16
      text `${status.available} ${status.state} ${status.access} ${status.addState}` testId="status"
      text (match status.apple { case some(a) => a.authorizationStatus + " " + a.addOnlyAuthorizationStatus, case none => "none" }) testId="apple"
      text `${list.assets.length}` testId="count"
      text `${all.pages} ${all.count} ${all.distinct} ${all.ordered}` testId="all"
      text `${shots.pages} ${shots.count} ${shots.distinct} ${shots.ordered} ${shots.marked} ${shots.first}` testId="shots"
      text first testId="first"
      text (match list.assets.at(0) { case some(a) => `${a.width}x${a.height} ${a.picture == "photos:" + a.id}`, case none => "" }) testId="first-size"
      text `${loads} ${errors} ${lastError}` testId="pictures"
      row gap=4 flex-wrap="wrap"
        for a, i in list.assets.slice(0, 6) key=a.id
          image a.picture testId=`picture-${i + 1}` width=60 height=60 object-fit="cover" alt=`Photo ${i + 1}` load=loaded error=failed
      text (match copied { case some(c) => `${c.path} ${c.type} ${c.size > 0} ${c.width}x${c.height}`, case none => "none" }) testId="copied"
      text copyError testId="copy-error"
      text (match added { case some(a) => (match a.asset { case some(id) => id, case none => "no id" }), case none => "none" }) testId="added"
      text addError testId="add-error"
      text (match managed { case some(s) => `${s.state} ${s.access}`, case none => "none" }) testId="managed"
      text manageError testId="manage-error"
      button press=read testId="read"
        text "Read"
      button press=readAll(500) testId="read-all"
        text "Read all"
      button press=readAll(2) testId="read-all-2"
        text "Read all, 2 a page"
      button press=readShots(500) testId="read-shots"
        text "Read screenshots"
      button press=readShots(2) testId="read-shots-2"
        text "Read screenshots, 2 a page"
      button press=watch testId="watch"
        text "Watch"
      if watching
        Changes()
      button press=copyFirst testId="copy"
        text "Copy"
      button press=addCopy testId="add"
        text "Add"
      button press=manage testId="manage"
        text "Manage"

// What changed since a token (LLP 1133.019.000), shown by testId for the
// drives: the ids of each list, the flags, the error and the token. Advance
// takes the answer's token; Since takes any text; Screenshots narrows the
// view, its word given twice, as the module takes it once.
component Changes
  state since = ""
  state limit = 500
  state shots = false
  resource changes = photoChanges(since=since, limit=limit, subtypes=(shots ? ["screenshot", "screenshot"] : [])) as shape PhotoChanges else empty()
  action advance(next: string)
    since = next
  action setSince(value)
    since = value
  action pageOfOne
    limit = 1
  action onlyScreenshots
    shots = true
  view
    column gap=4
      text `${changes.added.map(a => a.id).join(",")}|${changes.updated.map(a => a.id).join(",")}|${changes.deleted.join(",")}|${changes.more} ${changes.expired}` testId="changes"
      text (match failure(changes) { case some(f) => f.code, case none => "" }) testId="changes-error"
      text changes.token testId="token"
      row gap=8
        button press=advance(changes.token) testId="advance"
          text "Advance"
        button press=pageOfOne testId="page-of-one"
          text "One a page"
        button press=onlyScreenshots testId="only-screenshots"
          text "Screenshots"
      input value=since input=setSince aria-label="Since" testId="since"
