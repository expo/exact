{
  "kind": "interface",
  "name": "@exact/clipboard",
  "version": "1.0.0",
  "substitute": "implementation",
  "grants": ["clipboard.read"],
  "shapes": {
    "ClipboardItem": {
      "record": {
        "text/plain": {
          "type": "string",
          "maxBytes": 1048576
        },
        "text/html": {
          "type": "string",
          "maxBytes": 1048576,
          "targets": ["macos", "ios", "web"]
        },
        "image/png": {
          "type": "path",
          "access": "read",
          "or": "bytes",
          "maxBytes": 2097152
        }
      }
    }
  },
  "names": [
    {
      "send": "read",
      "contract": false,
      "params": [],
      "options": {},
      "answers": "ClipboardItem[]",
      "origin": "input",
      "grants": ["clipboard.read"],
      "substitute": {
        "unsupported": ["linux", "tvos", "windows"]
      }
    },
    {
      "send": "readText",
      "contract": false,
      "params": [],
      "options": {},
      "answers": "string",
      "origin": "input",
      "grants": ["clipboard.read"],
      "substitute": {
        "unsupported": ["linux", "tvos", "windows"]
      }
    },
    {
      "send": "write",
      "contract": false,
      "params": ["data"],
      "options": {
        "data": "ClipboardItem[]"
      },
      "answers": null,
      "origin": "app",
      "sequence": "write",
      "substitute": {
        "unsupported": ["android", "linux", "tvos"]
      }
    },
    {
      "send": "writeText",
      "contract": false,
      "params": ["data"],
      "options": {
        "data": {
          "type": "string",
          "maxBytes": 1048576
        }
      },
      "answers": null,
      "origin": "app",
      "sequence": "write",
      "substitute": {
        "unsupported": ["android", "linux", "tvos"]
      }
    }
  ]
}
