{
  "kind": "interface",
  "name": "@exact/global-shortcuts",
  "version": "1.1.0",
  "grants": ["device.global-shortcuts"],
  "agent": { "globalpointerdown": "GlobalPointerEvent", "globalpointerup": "GlobalPointerEvent" },
  "shapes": {
    "GlobalPointer": { "listening": "bool" },
    "GlobalPointerEvent": {
      "screenX": "number", "screenY": "number", "button": "number",
      "altKey": "bool", "ctrlKey": "bool", "metaKey": "bool", "shiftKey": "bool",
      "timeStamp": "number"
    },
    "GlobalShortcut": {
      "id": "string",
      "keys": "string",
      "registered": "bool",
      "reason": "option<enum<in-use|reserved|not-allowed|unsupported|invalid>>"
    },
    "GlobalShortcutCheck": {
      "keys": "string",
      "registered": "bool",
      "reason": "option<enum<in-use|reserved|not-allowed|unsupported|invalid>>"
    },
    "GlobalShortcutStatus": {
      "available": "bool",
      "releaseEvents": "bool",
      "apple": "option<AppleGlobalShortcutStatus>"
    },
    "GlobalShortcutEvent": {
      "id": "string",
      "keys": "string"
    }
  },
  "names": [
    {
      "source": "globalShortcut",
      "live": true,
      "origin": "app",
      "grants": ["device.global-shortcuts"],
      "options": { "id": "string", "keys": "string" },
      "answers": "GlobalShortcut",
      "substitute": {
        "shortcut": "register",
        "partial": true,
        "list": {
          "state": "globalShortcuts",
          "key": "id",
          "tap": { "event": "globalshortcut", "releaseEvent": "globalshortcutup", "releaseTargets": ["macos"], "keep": true, "args": ["id", { "id": "id", "keys": "keys" }] }
        },
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    {
      "send": "checkGlobalShortcut",
      "origin": "app",
      "grants": ["device.global-shortcuts"],
      "options": { "keys": "string" },
      "answers": "GlobalShortcutCheck",
      "substitute": {
        "shortcut": "check",
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    {
      "source": "globalShortcutStatus",
      "live": true,
      "answers": "GlobalShortcutStatus",
      "sync": { "name": "globalShortcutStatusSync", "from": "read" },
      "substitute": {
        "partial": true,
        "default": { "available": true, "releaseEvents": false },
        "targets": { "macos": { "releaseEvents": true } },
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    {
      "source": "globalPointer",
      "live": true,
      "origin": "input",
      "grants": ["device.global-pointer"],
      "answers": "GlobalPointer",
      "substitute": {
        "unsupported": ["windows", "linux", "web", "ios", "android", "tvos", "watchos", "visionos", "terminal"]
      }
    },
    { "event": "globalpointerdown", "on": "root", "raised": "emit", "args": ["GlobalPointerEvent"], "hold": 64 },
    { "event": "globalpointerup", "on": "root", "raised": "emit", "args": ["GlobalPointerEvent"], "hold": 64 },
    { "event": "globalshortcut", "on": "root", "raised": "activation", "args": ["string", "GlobalShortcutEvent"], "hold": 16 },
    { "event": "globalshortcutup", "on": "root", "raised": "activation", "args": ["string", "GlobalShortcutEvent"], "hold": 16 }
  ]
}
