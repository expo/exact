// LLP 1013.002 D4: the destination flies, and the live player moves into it.
// Only the top route declares a destination; replacing it pairs the old box
// and the new one by `sharedElement`, and both route parts cut. After
// DorianMazur's fixture for #698.
routes nav
  tab home "/"
  detail "/detail"

style Route
  ::view-transition-new
    animation="none"
  ::view-transition-old
    animation="none"

style Flight
  -exact-layout-transition="450ms ease"

component App
  derive open = top(nav).name == "detail"
  state alive = true
  state loads = 0
  state position = 0
  action show
    nav = push(nav, path("detail"))
  action back
    nav = back(nav)
  action remove
    alive = not alive
  action loaded
    loads = loads + 1
  action timed(seconds)
    position = seconds
  view
    main position="relative" navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for entry in stack(nav) key=entry.id
        column navigationKey=`${entry.id}` class=Route position="absolute" top=0 right=0 bottom=0 left=0 padding=16 gap=12
          if entry.id == top(nav).id
            if open
              button id="back" press=back testId="toggle"
                text "Back"
            else
              button press=show testId="toggle"
                text "Open"
            button press=remove testId="remove"
              text (alive ? "Remove player" : "New player")
            if open
              column id="detail-player" testId="detail" sharedElement="player" class=Flight width="100%" height=320
            else
              column id="card-player" testId="card" sharedElement="player" class=Flight width=168 height=148
      if alive
        column portal=(open ? "detail-player" : "card-player") testId="player" width="100%" height="100%"
          video "assets/motion.mp4" testId="video" loadedmetadata=loaded timeupdate=timed autoplay=true muted=true playsinline=true loop=true controls=true width="100%" flex=1 min-height=0
          Counter()

component Counter
  state count = 0
  action increment
    count = count + 1
  view
    button press=increment testId="count"
      text `Count ${count}`
