// LLP 1013.002 §2: one video and counter, declared once, shown in the feed
// card and in the detail that expands from it. `portal` names where the same
// element is shown; the card stays mounted under the detail, so Back returns
// both to it. Remove and New make a fresh player.
routes nav
  tab feed "/"
  detail "/detail"

component App
  derive open = top(nav).name == "detail"
  state alive = true
  state loads = 0
  action show
    nav = push(nav, path("detail"))
  action back
    nav = back(nav)
  action remove
    alive = not alive
  action loaded
    loads = loads + 1
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for entry in stack(nav) key=entry.id
        if entry.name == "feed"
          column navigationKey=`${entry.id}` gap=12 padding=16
            button press=show testId="open"
              text "Open"
            button press=remove testId="remove"
              text (alive ? "Remove player" : "New player")
            box id="card-player" testId="card" width=168 height=148
        else if entry.name == "detail"
          column navigationKey=`${entry.id}` navigationPresentation="fullscreen" navigationSource="card-player" gap=12 padding=16
            button id="back" press=back testId="back"
              text "Back"
            box id="detail-player" testId="detail" width="100%" height=320
      if alive
        box
          column portal=(open ? "detail-player" : "card-player") testId="player" width="100%" height="100%"
            video "assets/motion.mp4" testId="video" loadedmetadata=loaded autoplay=true muted=true playsinline=true loop=true width="100%" flex=1 min-height=0
            Counter()

component Counter
  state count = 0
  action increment
    count = count + 1
  view
    button press=increment testId="count"
      text `Count ${count}`
