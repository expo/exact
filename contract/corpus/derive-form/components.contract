      Section(fields=fields, section=16, name="16")
      Section(fields=fields, section=17, name="17")
      Section(fields=fields, section=18, name="18")
component Section
  props
    fields: Field[]
    section: number
    name: string
  state draft = ""
  derive picked = fields.filter(f => f.section == section and f.on and f.label.length > 2)
  derive labels = picked.map(f => f.label).join(", ")
  derive count = picked.length
  action edit(value: string)
    draft = value
  view
    column
      input value=draft input=edit testId=`edit${name}`
      text `${draft}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      text `${labels}: ${count}`
      for field in picked key=field.id
        text `${field.label} ${labels}`
