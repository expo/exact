  action edit18(value: string)
    draft18 = value
  action editField(value: string)
    fields = fields.map(f => f.id % 1000 == 0 ? Field(section=f.section, id=f.id, label=value, on=f.on) : f)
  action toggle
    fields = fields.map(f => f.id % 1000 == 0 ? Field(section=f.section, id=f.id, label=f.label, on=!f.on) : f)
  action rekey
    fields = fields.map(f => Field(section=f.section, id=f.id + 1000, label=f.label, on=f.on))
  view
    column
      input input=editField testId="field"
      button "toggle" press=toggle testId="toggle"
      button "rekey" press=rekey testId="rekey"
