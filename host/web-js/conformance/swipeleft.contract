// Synthetic conformance plan: `swipeleft`, `swiperight`'s mirror (Charlie,
// 2026-11-10). One row swipes left only, one both ways: each action runs once
// when the finger lifts past the 64-point knee its way, and not short of it
// or the other way on a node without that handler.
component SwipeLeft
  state said = ""
  action say(way: string)
    said = `${said}${way}`
  view
    column gap=12 padding=12
      text said testId="said"
      box testId="left-row" swipe=say("L") swipe-follow="left" touch-action="pan-y" width=300 height=60 background-color="#dddddd" transition="translate -exact-spring(300, 30, 1)"
        text "left only"
      box testId="right-row" swipe=say("r") swipe-follow="right" touch-action="pan-y" width=300 height=60 background-color="#cccccc" transition="translate -exact-spring(300, 30, 1)"
        text "right only"
