// GroupedCustomHeadersIOSTests': a plain list whose sections' headers hold an avatar beside a name, as a UIKit list's
// header with an image and a text does, over swipe-to-delete link rows; `plain` makes each header one text, and the
// last section's always is.
component App
  state groups = ["Ryu", "Ken", "Guile"]
  state moves = [1, 2, 3, 4, 5, 6, 7, 8]
  state plain = false
  action remove(move: number)
    moves = moves.filter(m => m != move)
  action toggle
    plain = not plain
  view
    column testId="root" width="100%" height="100%"
      button testId="toggle" press=toggle
        text "Toggle"
      list id="favorites" testId="list" appearance="auto" listStyle="plain" flex=1 min-height=0
        for g in groups key=g
          if plain
            section
              header
                text g
              for m in moves key=m
                link href=`/moves/${m}` delete=remove(m) padding-top=19 padding-bottom=19
                  column flex=1 min-width=0 gap=4
                    text `Move ${m}` testId=`title-${g}-${m}`
                    text "236P"
                  image "symbol:forward-chevron"
          else
            section
              header testId=`header-${g}`
                row gap=8 align-items="center"
                  column testId=`avatar-${g}` width=24 height=24 border-radius=4 overflow="hidden" background-color="#cc3333" aria-hidden=true
                    image `assets/characters/${g}.png` width="100%" height="100%" object-fit="contain"
                  text g testId=`name-${g}` font="-exact-subheadline" font-weight=600 color="#cc3333"
              for m in moves key=m
                link href=`/moves/${m}` delete=remove(m) padding-top=19 padding-bottom=19
                  column flex=1 min-width=0 gap=4
                    text `Move ${m}` testId=`title-${g}-${m}`
                    text "236P"
                  image "symbol:forward-chevron"
        section
          header
            text "Plain"
          row
            text "Last"
