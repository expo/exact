// LLP 1168.000 D6.1: the chat bubble's trailing time (docs/recipes/chat-header.md) on iOS; TrailingTimeIOSTests reads
// each message's line fragments and the time's frame. host/web/tests/trailing-time.test.mjs checks the web.
component App
  view
    column padding=12 gap=8 align-items="flex-start"
      box position="relative" max-width=220 padding="6px 10px" border-radius=16 background-color="-exact-fill" testId="bubble-short"
        text white-space="pre-wrap" testId="body-short"
          text "See you"
          text "  9:41" opacity=0 aria-hidden="true"
        text "9:41" position="absolute" right=8 bottom=4 font="-exact-caption2" color="-exact-secondary-label" testId="time-short"
      box position="relative" max-width=220 padding="6px 10px" border-radius=16 background-color="-exact-fill" testId="bubble-two"
        text white-space="pre-wrap" testId="body-two"
          text "Running late,\nsorry"
          text "  9:41" opacity=0 aria-hidden="true"
        text "9:41" position="absolute" right=8 bottom=4 font="-exact-caption2" color="-exact-secondary-label" testId="time-two"
      box position="relative" direction="rtl" max-width=220 padding="6px 10px" border-radius=16 background-color="-exact-fill" testId="bubble-rtl"
        text white-space="pre-wrap" testId="body-rtl"
          text "נתראה מחר"
          text "‏  9:41" opacity=0 aria-hidden="true"
        text "9:41" position="absolute" left=8 bottom=4 font="-exact-caption2" color="-exact-secondary-label" testId="time-rtl"
      box position="relative" direction="rtl" max-width=220 padding="6px 10px" border-radius=16 background-color="-exact-fill" testId="bubble-mixed"
        text white-space="pre-wrap" testId="body-mixed"
          text "נתראה ב-Zoom"
          text "‏  9:41" opacity=0 aria-hidden="true"
        text "9:41" position="absolute" left=8 bottom=4 font="-exact-caption2" color="-exact-secondary-label" testId="time-mixed"
      box position="relative" max-width=220 padding="6px 10px" border-radius=16 background-color="-exact-fill" testId="bubble-edge0"
        text white-space="pre-wrap" testId="body-edge0"
          text "Meet at abcdef"
          text "  9:41" opacity=0 aria-hidden="true"
        text "9:41" position="absolute" right=8 bottom=4 font="-exact-caption2" color="-exact-secondary-label" testId="time-edge0"
      box position="relative" max-width=220 padding="6px 10px" border-radius=16 background-color="-exact-fill" testId="bubble-edge1"
