// Regression fixture for #2071 collapsed UISplitViewController Back projection:
// - Top-level `navigationSplit="split"` root (`library`) and detail (`detail`).
// - `detail` has a header with `button id="back"` (`press=leaveSession`), a leading
//   supplement button (`split-lead`), a heading, and a trailing button (`split-trail`).
// - `mode` controls `leaveSession`: `"confirm"` opens a confirmation alert while
//   keeping detail mounted; `"pop"` pops detail back to the list root.
routes nav
  library "/"
    detail "/detail"

component SplitBackGuard
  state mode = "confirm"
  state leaves = 0
  state backTitled = true
  action openDetail
    nav = push(nav, "/detail")
  action setMode(next: string)
    mode = next
  action toggleTitled
    backTitled = not backTitled
  action leaveSession
    leaves = leaves + 1
    if mode == "confirm"
      showModal("leave-confirm")
    else
      nav = back(nav)
  action confirmLeave
    close("leave-confirm")
    nav = back(nav)
  action cancelLeave
    close("leave-confirm")
  action noop
    let _ = 0
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "library"
          column navigationKey=`${e.id}` navigationSplit="split" position="absolute" inset=0 display="flex" flex-direction="column" testId="route-library"
            header display="flex" align-items="center" padding="8px 16px"
              text "Library" role="heading" aria-level=1
            column padding=16 gap=8
              button press=openDetail testId="open-split-detail"
                text "Open Detail"
              button press=toggleTitled testId="split-toggle-titled"
                text "Toggle Titled"
              button press=setMode("pop") testId="split-mode-pop"
                text "Mode Pop"
        else if e.name == "detail"
          column navigationKey=`${e.id}` position="absolute" inset=0 display="flex" flex-direction="column" testId="route-detail"
            header display="flex" align-items="center" padding="8px 16px" gap=8
              button id="back" press=leaveSession testId="split-back" aria-label="Back to Library"
                if backTitled
                  text "Library"
                else
                  image "symbol:back"
              button press=noop testId="split-lead"
                text "Lead"
              text "Detail" role="heading" aria-level=2 testId="split-title"
              button press=noop testId="split-trail"
                text "Trail"
            column padding=16 gap=8
              text `leaves:${leaves}` testId="split-leaves"
              button press=toggleTitled testId="detail-split-toggle-titled"
                text "Toggle Titled"
      dialog id="leave-confirm" role="alertdialog" aria-label="Leave detail?" testId="confirm-dialog"
        text "Unsaved changes."
        button press=confirmLeave command="close" commandfor="leave-confirm" testId="confirm-leave"
          text "Leave"
        button command="close" commandfor="leave-confirm" press=cancelLeave testId="cancel-leave"
          text "Stay"
