// The UIKit sheet's point reads cross the native top-layer ABI.
component App
  state taps = ""
  action record(event: string)
    taps = taps + event
  state contentHeight = 100
  action grow
    contentHeight = 300
  state hit = "unread"
  state hits = "unread"
  state rect = "unread"
  state seen = false
  state observations = 0
  action intersected(e: IntersectionObserverEntry)
    seen = e.isIntersecting
    observations = observations + 1
  action read(e: PointerEvent)
    let f = frame("content")
    rect = `${f.x},${f.y},${f.width},${f.height}`
    hit = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "none" }
    hits = elementsFromPoint(e.clientX, e.clientY).join(",")
  view
    main id="page" width="100%" height="100%"
      dialog id="form" width=300 height=1800 pointermove=read
        column id="content" width=100 height=50 margin-left=20 margin-top=40
          text "Visible"
        column id="clipped" intersect=intersected position="absolute" left=20 top=1700 width=100 height=50
          text "Clipped"
      dialog id="responsive" width="100%" height=180
        text "Sheet width"
      dialog id="resizable" width="100%" padding=0 navigationDetent="medium large" navigationInitialDetent="large" navigationGrabber="hidden"
        column height="100%" min-height=0
          column flex=1 min-height=0 overflow-y="auto"
            column height=1200
          button testId="dialog-footer" flex-shrink=0
            text "Footer"
      dialog id="fitted-rests" navigationDetent="fit-content large"
        ::backdrop
          background-color="#20304080"
        view width=100 height=contentHeight press=grow testId="grow-fitted"
      dialog id="growing" width=300
        view width=100 height=contentHeight press=grow testId="grow-sheet"
      dialog id="percentage" width=300 height="50%"
        text "Half the available height"
      dialog id="tall" width=300
        button id="tall-tip-button" popovertarget="tall-tip"
          text "Show tip"
        column id="tall-tip" popover="manual" width=200 height=40
          text "A tip"
        column height=2000 flex-shrink=0
      dialog id="painted-tall" width=300 closedby="any" background-color="-exact-secondary-grouped-background"
        column height=2000 flex-shrink=0
        button id="painted-tall-close" commandfor="painted-tall" command="close"
          text "Close"
      dialog id="painted-deep" width=300 height=200 background-color="-exact-secondary-grouped-background"
        column height=100
          column height=2000 flex-shrink=0
          button id="painted-deep-close" commandfor="painted-deep" command="close"
            text "Close"
      dialog id="painted-point" width=100 height=100 background-color="-exact-secondary-grouped-background" pointer-events="none" pointermove=read
        column id="point-pop" popover="manual" pointer-events="auto" position="absolute" left=20 top=120 width=50 height=50
      button "Page" id="page-button" press=record("page") width=100 height=44 margin-top=80
      dialog id="tap-sheet" width=280 closedby="any" cancel=record("cancel") close=record("close")
        input id="sheet-field" aria-label="Name"
        button "Save" id="sheet-save" press=record("save") commandfor="tap-sheet" command="close"
      dialog id="tap-painted" width=280 closedby="any" background-color="-exact-secondary-grouped-background" cancel=record("cancel") close=record("close")
        input id="painted-field" aria-label="Name"
        button "Save" id="painted-save" press=record("save") commandfor="tap-painted" command="close"
