routes nav
  home "/"
  sheet "/sheet"
  detail "/detail"

component App
  state hit = "unread"
  state hits = "unread"
  action open(name: string)
    nav = push(nav, "/" + name)
  action read(e: PointerEvent)
    hit = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "none" }
    hits = elementsFromPoint(e.clientX, e.clientY).join(",")
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column id=e.name navigationKey=`${e.id}` navigationPresentation=(e.name == "sheet" ? "modal" : "") navigationDetent="300" pointer-events="none" pointermove=read position="absolute" inset=0
          header
            text e.name role="heading" aria-level=2
          if e.name == "home"
            button press=open("sheet") testId="open-sheet" pointer-events="auto"
              text "Open sheet"
          else if e.name == "sheet"
            button press=open("detail") testId="open-detail" pointer-events="auto"
              text "Push detail"
