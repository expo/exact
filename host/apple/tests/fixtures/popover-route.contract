routes nav
  home "/"
  pop "/pop"

component App
  state adaptation = "none"
  state arrows = "any"
  state shown = true
  action open()
    nav = push(nav, "/pop")
  action down()
    arrows = "down"
  action adapt()
    adaptation = "sheet"
  action hide()
    shown = false
  action show()
    shown = true
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationPresentation=(e.name == "pop" ? "popover" : "") navigationPopoverAnchor="anchor" navigationPopoverAdaptation=(adaptation) navigationPopoverArrows=(arrows) navigationPopoverMargins="12 20" navigationEdgeAttachedInCompactHeight="true" navigationWidthFollowsPreferredContentSize="true" width=(e.name == "pop" ? 240 : 402) height=(e.name == "pop" ? 180 : 874) testId=e.name
          if e.name == "home"
            if shown
              button id="anchor" testId="anchor" press=open() margin-top=300
                text "Open"
            button testId="open" press=open()
              text "Open without its anchor"
            button testId="hide" press=hide()
              text "Hide the anchor"
            button testId="show" press=show()
              text "Show the anchor"
          else
            text "In the popover"
            button testId="down" press=down()
              text "Arrow down"
            button testId="adapt" press=adapt()
              text "Adapt"
            button testId="hide-anchor" press=hide()
              text "Hide the anchor"
