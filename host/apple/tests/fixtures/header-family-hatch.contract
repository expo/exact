routes nav
  home "/"
    notes "/notes"

component RouteHatch
  action open
    nav = push(nav, "/notes")
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0
          if e.name == "home"
            header
              text "Library" role="heading"
              button press=open testId="open"
                text "Open"
          else
            header font-family="Georgia"
              row
                image "symbol:star"
                text "Notes" role="heading" aria-level=2 color="#ff0000"
          scroll flex=1 min-height=0
            text "Reading list"
