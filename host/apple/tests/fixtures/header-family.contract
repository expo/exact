routes nav
  home "/"
    detail "/detail"

component BarFamily
  state phase = 0
  action resize
    phase = phase + 1
  action open
    nav = push(nav, "/detail")
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0
          if e.name == "home"
            header
              text "Library" role="heading" aria-level=1
              button press=open testId="open"
                text "Open"
          else
            header font-family=(phase < 3 ? "Georgia" : phase == 3 ? "Exact Missing Family" : phase == 4 ? "Georgia, Menlo" : "Georgia, Courier") testId="header"
              button id="back" press=back testId="back"
                text "Shelf"
              if phase == 2
                text "Notes" role="heading" aria-level=1 font-family="Menlo"
              else
                text "Notes" role="heading" aria-level=(phase == 1 ? 1 : 2)
              button press=resize buttonStyle=(phase == 1 or phase == 2 ? "prominent-glass" : "plain") testId="save"
                text "Save"
          scroll flex=1 min-height=0
            text "Reading list"
