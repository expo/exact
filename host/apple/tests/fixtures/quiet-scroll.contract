keyframes appear
  from opacity=0
  to opacity=1

component App
  state items = range(100)
  action prepend
    items = [-items.length].concat(items)
  view
    column
      button "Prepend" press=prepend testId="prepend"
      list virtualized=true height=300 width=400 estimated-item-height=100 testId="feed"
        for n in items key=n
          view width="100%" height=100
            text `${n}` testId=`coin-${n}` animation="appear 600ms" -exact-animation-trigger="view"
