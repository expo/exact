routes nav
  tab labs "/"
    typography "/typography"
    swift "/swift"
    section "/section"
      detail "/section/detail"
    single "/single"
      plain "/single/plain"
  tab controls "/controls"
  tab sound "/sound"

component ToolbarTabs
  state last = ""
  action pressItem(name: string)
    last = name
  action back
    nav = back(nav)
  action pick(name: string)
    nav = select(nav, name)
  view
    main navigationBack="back" navigationKey=`${top(nav).id}` width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "typography" or e.name == "swift" or e.name == "single" or e.name == "detail"
                Page(visit=`${e.id}`, name=e.name, last=last)
                  row role="toolbar" toolbarPlacement="bottom"
                    if e.name != "single"
                      button testId="reshape" press=pressItem("Reshape")
                        text "Reshape"
                      spacer
                    if e.name == "swift"
                      button testId="animate" press=pressItem("Animate symbol")
                        text "Animate symbol"
                      spacer
                    button testId="widget" press=pressItem("Widget")
                      text "Widget"
              else
                Page(visit=`${e.id}`, name=e.name, last=last)
      row role="tablist"
        for t in nav.tabs key=t.name
          button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=pick(t.name) testId=`tab-${t.name}`
            image (t.name == "labs" ? "symbol:sf/flask" : t.name == "controls" ? "symbol:adjust" : "symbol:speaker")
            text (t.name == "labs" ? "Labs" : t.name == "controls" ? "Controls" : "Sound")

component Page
  props
    visit: string
    name: string
    last: string
  slot
  view
    column navigationKey=visit navigationScroll="content" position="absolute" inset=0 background-color="-exact-background"
      header
        text (name == "typography" ? "Type & glass" : name == "swift" ? "SwiftUI playground" : name) role="heading" aria-level=2
      scroll id="content" flex=1 min-height=0
        if name == "labs"
          link href="/typography" testId="open-type"
            text "Type & glass"
          link href="/swift" testId="open-swift"
            text "SwiftUI playground"
          link href="/single" testId="open-single"
            text "Single action"
        if name == "single"
          link href="/single/plain" testId="open-plain"
            text "Next screen"
        text last testId="last"
      children
