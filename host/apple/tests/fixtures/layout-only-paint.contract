component App
  state opacity: number = 1
  action fade
    opacity = 0.4
  view
    column height="100%" width="100%"
      button press=fade testId="fade" height=40
        text "Fade"
      button appearance="none" popovertarget="choices" testId="opener" height=40 width=80
        text "Open"
      column popover="auto" id="choices" position="absolute" top=300 left=0 width=100 height=60
        text "Choices"
      list virtualized=true appearance="none" width=200 height=200 estimated-item-height=100
        for n in [0] key=n
          row width=200 height=100 testId="overlap"
            column width=80 height=80
              image "app:/first.png" testId="first" width=80 height=80 opacity=opacity background-color="red"
            column width=80 height=80 margin-left=-40
              image "app:/last.png" testId="last" width=80 height=80 background-color="blue"
      list virtualized=true appearance="none" width=200 height=200 estimated-item-height=100
        for n in [0] key=n
          row width=200 height=100 testId="covered-row"
            column width=100 height=100
              text "A" testId="a-text"
            column width=100 height=100 margin-left=-60
              text "B"
