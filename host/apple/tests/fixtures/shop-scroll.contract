component App
  state items = range(120)
  action remove(n)
    items = items.filter(i => i != n)
  view
    list virtualized=true appearance="none" height=600 width=400 estimated-item-height=330 testId="product-grid"
      for n in items key=n
        column
          row gap=12 padding-left=16 padding-right=16 padding-bottom=20 align-items="flex-start"
            for c in [0, 1] key=c
              column flex=1 min-width=0
                button press=remove(n) appearance="none" width="100%" display="flex" flex-direction="column" gap=8 text-align="start"
                  image "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGPImFYAAALYAW/T3f73AAAAAElFTkSuQmCC" width="100%" aspect-ratio="3 / 4" object-fit="cover" border-radius=8 background-color="#F4F1EC" alt=""
                  text `Product ${n * 2 + c}` font-size=14 line-height="18px" line-clamp=2 overflow="hidden"
                  row gap=6
                    text "$24.00" font-size=15
                    text "$30.00" font-size=15
