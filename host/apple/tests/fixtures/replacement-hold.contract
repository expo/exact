// A field and a label for ReplacementHoldTests (LLP 1029.000.002 D9);
// xctest.mjs compiles a second plan whose label reads "after".
component App
  state draft = ""
  action edit(value: string)
    draft = value
  view
    column width="100%" padding=10 gap=6
      input value=draft input=edit aria-label="Draft" testId="draft"
      text "before" testId="label"
