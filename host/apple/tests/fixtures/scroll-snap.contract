component App
  view
    column
      list testId="strip" virtualized=true display="flex" width=300 height=100 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 scroll-snap-align="start"
            text `Card ${n}`
      list testId="relative" virtualized=true display="flex" width=300 height=100 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 position="relative" left=30 scroll-snap-align="start"
      list testId="percent" virtualized=true display="flex" width=300 height=100 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 position="relative" left="10%" scroll-snap-align="start"
      list testId="transform" virtualized=true display="flex" width=300 height=100 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 transform="translateX(30px)" scroll-snap-align="start"
      list testId="descendant" virtualized=true display="flex" width=300 height=100 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 scroll-snap-align="none"
            view width=150 height=100 scroll-snap-align="start"
      list testId="center-x" border-left-width=10 border-right-width=30 virtualized=true display="flex" width=300 height=100 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 scroll-snap-align="center"
      list testId="center-y" border-top-width=10 border-bottom-width=30 virtualized=true width=100 height=300 estimated-item-height=150 scroll-snap-type="y mandatory"
        for n in range(1000) key=n
          view width=100 height=150 scroll-snap-align="center"
      list testId="gapped" virtualized=true display="flex" width=300 height=(50 * 2) gap=14 overflow-x="scroll" overflow-y="hidden" estimated-item-width=150 scroll-snap-type="x mandatory"
        for n in range(1000) key=n
          view width=150 height=100 flex-shrink=0 scroll-snap-align="end"
      list testId="hidden-boundaries" virtualized=true display="flex" width=300 height=100 gap=14 padding-left=40 padding-right=40 overflow-x="scroll" overflow-y="hidden" estimated-item-width=100
        for n in range(4) key=n
          view width=100 height=100 display=(n == 0 || n == 3 ? "none" : "block")
