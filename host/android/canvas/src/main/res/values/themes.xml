<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window is the platform's own for the scheme (LLP 1115.001 D3.6): before Android 12 the device's
         light theme's background here (its dark one's in values-night) with nothing on it, as the platform shows any
         app's window before it draws; from Android 12 the starting window (values-v31), the launcher icon on that
         background. exact2's first frame (~60 ms after the tap) replaces it, and from then on the window's background
         is the colour the host says is behind the page (ExactActivity.chrome). -->
    <style name="ExactLaunch" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
    <!-- Package-private host activity (LLP 1133.030 D9): transparent window over the app so a library
         requiring a ComponentActivity (bottom sheet, payment sheet) presents without a flash. -->
    <style name="ExactTranslucent" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- A scroller's indicator (Scrolling.Indicator): a view with the scrollbars View draws for one that scrolls,
         as android:scrollbars gives a ScrollView its. The thumb, its size and its fade are the theme's. -->
    <style name="ExactScrollbars">
        <item name="android:scrollbars">vertical|horizontal</item>
    </style>
    <!-- Edge-to-edge modal alert window (LLP 1115.001 D10, LLP 1105 D7): non-floating without
         FLAG_DIM_BEHIND so the dialog window covers both system bars and DisplayPolicy honors the
         page's light status/navigation bar appearance across API 29-37. -->
    <style name="ExactAlertDialog" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/ExactAlert</item>
    </style>
</resources>
