<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The launch window is the platform's own for the scheme (LLP 1115.001 D3.6): before Android 12 the device's
         light theme's background here (its dark one's in values-night) with nothing on it, as the platform shows any
         app's window before it draws; from Android 12 the starting window (values-v31), the launcher icon on that
         background. exact2's first frame (~60 ms after the tap) replaces it, and from then on the window's background
         is the colour the host says is behind the page (ExactActivity.chrome). -->
    <style name="ExactLaunch" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar" />
    <!-- A scroller's indicator (Scrolling.Indicator): a view with the scrollbars View draws for one that scrolls,
         as android:scrollbars gives a ScrollView its. The thumb, its size and its fade are the theme's. -->
    <style name="ExactScrollbars">
        <item name="android:scrollbars">vertical|horizontal</item>
    </style>
</resources>
