<?xml version="1.0" encoding="utf-8"?>
<!-- An alert opening (LLP 1115.001 D10): fade-only window animation so the fullscreen scrim stays
     at full display bounds without exposing undimmed strips during the transition. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"
    android:fromAlpha="0"
    android:interpolator="@android:interpolator/linear_out_slow_in"
    android:toAlpha="1" />
