<?xml version="1.0" encoding="utf-8"?>
<!-- Android 14: the platform's own role colours, light. Index i is exact2's Material role i (host/painted/src/presenter/palette.rs `Material`), the index a
     snapshot tree names a role colour by (LLP 1126.003 D2). The launcher resolves these ids itself, so a new wallpaper or
     the night mode recolours a widget with no code running. -->
