<?xml version="1.0" encoding="utf-8"?>
<!-- A text run's weight, style and tabular digits as a TextAppearanceSpan (LLP 1126.003 D2): the span crosses to the
     launcher by value, where a Typeface would not. Named ExactWidgetText.W<weight>[.Italic][.Tabular]. -->
<resources>
    <style name="ExactWidgetText.W100" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ExactWidgetText.W100.Tabular" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="ExactWidgetText.W100.Italic" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textStyle">italic</item>
    </style>
    <style name="ExactWidgetText.W100.Italic.Tabular" parent="">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textFontWeight">100</item>
        <item name="android:textStyle">italic</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
