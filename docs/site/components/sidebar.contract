use Nav, NavItem from "./shapes.contract"

style Item
  padding-top=8 padding-bottom=8 padding-right=12 border-radius="var(--radius-lg)"

// A guide split into sections is a parent, open only while the reader has opened it with its chevron.
fn isOpen(route: string, opened: string[]): bool = opened.includes(route)

component Tabs
  props
    nav: Nav
    tab: string
    prefix: string
  view
    nav aria-label="Sections" flex=1 min-width=0
      column gap=2 padding="0 16px"
        for t in nav.tabs key=t.id
          link href=t.href id=`${prefix}tab-${t.id}` testId=`${prefix}tab-${t.id}` aria-current=(t.id == tab ? "true" : "false") padding="8px 12px" border-radius="var(--radius-lg)" background-color=(t.id == tab ? "var(--color-background-selected)" : "transparent")
            row align-items="center" gap=8
              image t.icon aria-hidden=true width="1rem" height="1rem" color="var(--color-icon-default)"
              text t.title font-size="var(--text-sm)" font-weight=500 line-height=1.4 color="var(--color-text-default)"

component NavLink
  props
    item: NavItem
    current: string
    prefix: string
    group: bool
  view
    if item.route == current
      link href=item.href aria-current="page" id=`${prefix}nav-${item.route}` testId=`${prefix}nav-${item.route}` class=Item flex=(group ? "0 1 auto" : "1") min-width=0 padding-left=(12 + item.depth * 14) padding-right=(group ? 0 : 12) background-color=(group ? "transparent" : "var(--color-background-selected)")
        row
          text item.title font-size="var(--text-sm)" font-weight=(item.depth == 0 ? 500 : 400) line-height=1.4 color=(item.depth == 0 ? "var(--color-text-default)" : "var(--color-text-secondary)")
    else
      link href=item.href id=`${prefix}nav-${item.route}` testId=`${prefix}nav-${item.route}` class=Item flex=(group ? "0 1 auto" : "1") min-width=0 padding-left=(12 + item.depth * 14) padding-right=(group ? 0 : 12)
        row
          text item.title font-size="var(--text-sm)" font-weight=(item.depth == 0 ? 500 : 400) line-height=1.4 color=(item.depth == 0 ? "var(--color-text-default)" : "var(--color-text-secondary)")

component Sidebar
  props
    nav: Nav
    current: string
    tab: string
    toggled: string[]
    toggle: action
    prefix: string
  view
    column padding=16 testId=`${prefix}sidebar`
      nav aria-label="Docs"
        column gap=16
          for g in nav.groups.filter(x => x.tab == tab) key=g.id
            column gap=2 -exact-layout-transition="250ms ease"
              if nav.groups.filter(x => x.tab == g.tab).length > 1
                text g.title text-transform="uppercase" font-family="var(--font-mono)" font-size="var(--text-xs)" font-weight=500 line-height=1 letter-spacing="-0.5px" color="var(--color-text-tertiary)" padding="8px 12px"
              for i in g.items.filter(x => x.depth == 0) key=i.id
                if i.children > 0
                  column -exact-layout-transition="250ms ease"
                    row align-items="center" gap=4 border-radius="var(--radius-lg)" background-color=(i.route == current ? "var(--color-background-selected)" : "transparent")
                      NavLink(item=i, current=current, prefix=prefix, group=true)
                      button press=toggle(i.route) appearance="none" aria-expanded=isOpen(i.route, toggled) aria-label=(isOpen(i.route, toggled) ? "Collapse" : "Expand") padding=4 border-radius="var(--radius-lg)" flex-shrink=0 testId=`${prefix}nav-toggle-${i.route}`
                        image "symbol:back" aria-hidden=true width="1rem" height="1rem" color="var(--color-icon-tertiary)" transition="rotate 200ms ease" rotate=(isOpen(i.route, toggled) ? "90deg" : "270deg")
                    column overflow="hidden" inert=(not isOpen(i.route, toggled)) max-height=(isOpen(i.route, toggled) ? `${i.children * 64}px` : "0px") opacity=(isOpen(i.route, toggled) ? 1 : 0) -exact-layout-transition="250ms ease" transition="opacity 200ms ease"
                      for c in g.items.filter(x => x.parent == i.route) key=c.id
                        view display="flex" testId=(isOpen(i.route, toggled) ? `${prefix}nav-open-${c.route}` : `${prefix}nav-item-${c.route}`)
                          NavLink(item=c, current=current, prefix=prefix, group=false)
                else
                  NavLink(item=i, current=current, prefix=prefix, group=false)
