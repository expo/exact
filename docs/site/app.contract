  agents "/agents" render=build activate=idle
  // routes: end
  notfound render=build activate=idle

// One layout for every width, made at build: CSS clamp() against 100vw shows the sidebar from 960px,
// "On this page" from 1280px, and the top bar with its Menu below 960px, so the page needs no runtime
// to fit its window. The not-found page resolves its URL through constants/redirects.ts (app.ts) and
// replaces it once the page shows, so a moved page and a trailing slash land on their page.
fn inSidebar(nav: Nav, route: string): bool = nav.groups.filter(g => g.items.filter(i => i.route == route).length > 0).length > 0

component App
  resource page = loadPage(top(nav).name) as shape Page else empty()
  resource site = loadNav() as shape Nav else empty()
  // Which chrome a reader can reach: the CSS clamp() layout draws it, and these keep what it hides
  // out of the tab order and the accessibility tree.
  resource viewport = exactViewport() as shape Viewport
  derive wide = viewport.width >= 960
  // The tab that holds the page; a route no tab holds (the not-found page) is shown under Home.
  derive tab = site.tabs.filter(t => t.routes.includes(top(nav).name)).map(t => t.id).concat(["home"]).slice(0, 1).join("")
  derive roomy = viewport.width >= 1280
  resource moved = resolveMoved(top(nav).name == "notfound" ? top(nav).url : "") as shape Moved else empty()
  mutation markdown as shape Markdown then copyFetched
  mutation address as shape Address then copyAddress
  mutation toolDestination as shape ToolDestination then openToolPage
  state searchOpen = false
  state query = ""
  state term = ""
  state chosen = 0
  resource hits = searchDocs(term) as shape SearchHit[] else empty()
  derive searching = query.trim().length >= 2 and (query.trim() != term or pending(hits))
  state menu = false
  state theme = "system" persist
  state sidebar = true persist
  state opened: string[] = []
  state navToggled: string[] = []
  state copied = false
  state linked = false
  state copiedId = ""
  state copies = 0
  state voted = ""
  state active = ""
  state visible: string[] = []
  derive from = page.movedFrom.includes(searchParam(top(nav), "from")) ? searchParam(top(nav), "from") : ""
  derive slashless = top(nav).name == "notfound" and top(nav).url.length > 1 and top(nav).url.endsWith("/") ? top(nav).url.slice(0, top(nav).url.length - 1) : ""
  derive destination = moved.go != "" ? moved.go : slashless
  state askedTool = ""
  state askedPath = ""
  state askedText = ""
  state askedCount = 0
  state navigationError = ""
  resource answered = answerTool(askedTool, askedPath, askedText, askedCount) as shape ToolAnswer else empty()
  tool search_docs reads "Searches the Exact docs and returns the matching sections as JSON, each with a title and a path. Pass a path to get_page_markdown to read a result." = toolSearch
    returns answered.text
    fails when answered.failed
  tool get_page_markdown reads "Returns a page of the Exact docs as Markdown. With a section, it returns only the parts under the headings that match, each with its parent headings." = toolMarkdown
    returns answered.text
    fails when answered.failed
  tool get_page_info reads "Returns the path, the title, the description, the date of the last change and the headings of a page of the Exact docs as JSON, without the page's text. Use it to find a section before reading the page with get_page_markdown." = toolInfo
    returns answered.text
    fails when answered.failed
  tool get_site_overview reads "Returns llms.txt: an index of every page of the Exact docs, each with its Markdown URL and a short description." = toolOverview
    returns answered.text
    fails when answered.failed
  tool list_sections reads "With an empty area, returns each area of the sidebar with the names of its sections as JSON. With an area, returns the pages of that area, or of one of its sections, each with a title and a path." = toolSections
    returns answered.text
    fails when answered.failed
  tool navigate_page writes closed "Opens a page of the Exact docs in this tab." = toolNavigate
    returns navigationError != "" ? navigationError : failed(page) ? `The page at ${top(nav).url} did not load.` : `Opened ${top(nav).url}.`
    fails when navigationError != "" or failed(page)
    available when not searchOpen
  action askTool(tool: string, path: string, text: string, count: number)
    askedTool = tool
    askedPath = path
    askedText = text
    askedCount = count
    refresh answered
  action toolSearch(query: string, limit: number)
    askTool("search_docs", "", query, limit)
  action toolMarkdown(path: string, section: string)
    askTool("get_page_markdown", path == "" ? top(nav).url : path, section, 0)
  action toolInfo(path: string)
    askTool("get_page_info", path == "" ? top(nav).url : path, "", 0)
  action toolOverview
    askTool("get_site_overview", "", "", 0)
  action toolSections(area: string, section: string)
    askTool("list_sections", area, section, 0)
  action toolNavigate(path: string)
    let current = top(nav)
    let hash = fragment(current)
    let location = path == "" ? current.url + (hash == "" ? "" : `#${hash}`) : path
    send toolDestination = resolveToolPage(location)
  action openToolPage
    match toolDestination
      case some(target)
        let error = searchOpen ? "Close the search dialog before opening a page." : target.error
        navigationError = error
        if error == ""
          let sameRoute = top(go(nav, target.url)).name == top(nav).name
          openPage(target.url)
          if sameRoute and (failed(page) or pending(page))
            refresh page
      case none
        navigationError = "The destination could not be resolved."
  action follow(url: string)
    close("search")
    openPage(url)
  action openPage(url: string)
    menu = false
    let next = go(nav, url)
    if top(next).id != top(nav).id
      copied = false
      linked = false
      copiedId = ""
      voted = ""
      visible = []
      active = ""
    nav = next
    // sidebar scrolling must not cancel the router's pending fragment scroll.
    if fragment(top(next)) == "" and inSidebar(site, top(next).name)
      scrollIntoView(`nav-${top(next).name}`, block="nearest", behavior="smooth")
  task revealing mount
    after(300, revealAtLoad)
  action revealAtLoad
    if inSidebar(site, top(nav).name)
      scrollIntoView(`nav-${top(nav).name}`, block="center", behavior="instant")
  task clearing when copied or linked or copiedId != "" key=copies
    after(2000, clearCopied)
  action clearCopied
    copied = false
    linked = false
    copiedId = ""
  // One control shows its tick at a time: a copy clears the others' and restarts the clearing.
  action copyBlock(id: string, text: string)
    copyText(text)
    copiedId = id
    copied = false
    linked = false
    copies = copies + 1
  action vote(answer: string)
    voted = answer
  action retryPage
    refresh page
  action toggle(id: string)
    opened = opened.includes(id) ? opened.filter(x => x != id) : opened.concat([id])
  action pick(set: string, id: string)
    opened = opened.filter(x => not x.startsWith(`${set}|`)).concat([id])
  action copyMarkdown
    send markdown = fetchMarkdown(top(nav).name)
  action copyLink
    send address = pageAddress(page.path)
  action copyAddress
    match address
      case some(a)
        copyText(a.url)
        linked = true
        copied = false
        copiedId = ""
        copies = copies + 1
      case none
        linked = false
  action seen(id: string, entry: IntersectionObserverEntry)
    let now = entry.isIntersecting ? (visible.includes(id) ? visible : visible.concat([id])) : visible.filter(x => x != id)
    visible = now
    match first(page.toc.filter(t => now.includes(t.href.slice(1))))
      case some(t)
        active = t.href.slice(1)
      case none
        visible = now
  action copyFetched
    match markdown
      case some(m)
        copyText(m.text)
        copied = true
        linked = false
        copiedId = ""
        copies = copies + 1
      case none
        copied = false
  action chooseTheme(value: string)
    theme = value
    setScheme(value)
  action toggleNav(route: string)
    navToggled = navToggled.includes(route) ? navToggled.filter(x => x != route) : navToggled.concat([route])
  action openSearch
    searchOpen = true
    showModal("search")
    focus("search-input")
  action searchClosed
    searchOpen = false
  action ask(v: string)
    query = v
    chosen = 0
  task settling when query.trim() != term key=query
    after(500, settle)
  action settle
    term = query.trim()
  action clearOrClose
    if query != ""
      query = ""
      term = ""
      focus("search-input")
    else
      close("search")
  action searchKey(k: string, e: KeyboardEvent)
    if k == "ArrowDown"
      preventDefault()
      chosen = chosen + 1 < hits.length ? chosen + 1 : chosen
    if k == "ArrowUp"
      preventDefault()
      chosen = chosen > 0 ? chosen - 1 : 0
    if k == "Enter" and not e.isComposing
      match hits.at(chosen)
        case some(h)
          follow(h.href)
        case none
          chosen = 0
  action toggleSidebar
    sidebar = not sidebar
  action toggleMenu
    menu = not menu
  action redirect(entry: IntersectionObserverEntry)
    if entry.isIntersecting and destination != ""
      nav = replace(nav, destination)
  view
    view navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color="var(--color-background-screen)" font-family="var(--font-sans)" color="var(--color-text-default)"
      for e in stack(nav).slice(-1) key=e.id
        column navigationKey=`${e.id}` navigationScroll=`page-${e.id}` navigationBar="none" position="absolute" inset=0 overflow-x="clip"
          padding-top="clamp(0px, (960px - 100vw) * 1000, 57px)" padding-left=(sidebar ? "calc(258px - clamp(0px, (960px - 100vw) * 1000, 258px))" : "calc(48px - clamp(0px, (960px - 100vw) * 1000, 48px))") -exact-layout-transition="220ms ease"
          if e.name == "notfound"
            head title=page.title description=page.description image=site.shareImage status=404
            if destination != ""
              view intersect=redirect height=1 testId="redirect"
          else
            head title=page.title description=page.description image=site.shareImage
          scroll id=`page-${e.id}` flex=1 min-width=0 -exact-layout-transition="220ms ease" background-color="var(--color-background-default)"
            margin="calc(4px - clamp(0px, (960px - 100vw) * 1000, 5px)) calc(16px - clamp(0px, (960px - 100vw) * 1000, 17px)) calc(16px - clamp(0px, (960px - 100vw) * 1000, 17px)) calc(8px - clamp(0px, (960px - 100vw) * 1000, 9px))" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-xl)"
            Article(page=page, nav=site, missing=(e.name == "notfound"), failed=failed(page), retry=retryPage, url=top(nav).url, moved=moved.to, suggestions=moved.suggestions, from=from, opened=opened, toggle=toggle, pick=pick, seen=seen, active=active, copyMarkdown=copyMarkdown, copied=copied, copyLink=copyLink, linked=linked, copiedId=copiedId, copyBlock=copyBlock, voted=voted, vote=vote, roomy=roomy, year=site.year, theme=theme, chooseTheme=chooseTheme)
      header appearance="none" inert=wide display="flex" align-items="center" justify-content="space-between" flex-shrink=0 overflow="hidden" position="absolute" top=0 left=0 right=0
        height="clamp(0px, (960px - 100vw) * 1000, 57px)" padding="0 16px" border-bottom="1px solid var(--color-border-secondary)" background-color="var(--color-background-default)"
        link href="/" class=Hit testId="home-bar"
          row align-items="center" gap=8
            image "symbol:icon.exactmark" aria-hidden=true width="1.625rem" height="1rem" color="var(--color-text-default)"
            text "Exact Docs" font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
        row gap=8 align-items="center"
          button press=openSearch appearance="none" aria-keyshortcuts="Meta+K Control+K" aria-label="Search the docs" padding=6 border-radius="var(--radius-lg)" testId="search-bar"
            image "symbol:search" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
          button press=toggleMenu appearance="none" aria-expanded=menu aria-controls="site-menu" padding="6px 12px" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-lg)" testId="menu"
            row gap=6 align-items="center"
              image (menu ? "symbol:close" : "symbol:menu") aria-hidden=true font-size="var(--text-sm)" color="var(--color-icon-default)"
              text (menu ? "Close" : "Menu") font-size="var(--text-sm)"
      column width=(sidebar ? "calc(266px - clamp(0px, (960px - 100vw) * 1000, 266px))" : "0px") -exact-layout-transition="220ms ease" flex-shrink=0 overflow="hidden" inert=(not wide or not sidebar) testId=(sidebar ? "sidebar-shown" : "sidebar-hidden") position="absolute" top=0 bottom=0 left=0
        row align-items="center" justify-content="space-between" padding="16px 24px 12px" width=266 box-sizing="border-box"
          link href="/" class=Hit testId="home"
            row align-items="center" gap=8
              image "symbol:icon.exactmark" aria-hidden=true width="1.625rem" height="1rem" color="var(--color-text-default)"
              text "Exact Docs" font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
          button press=toggleSidebar appearance="none" aria-label="Hide the sidebar" title="Hide the sidebar" padding=8 border-radius="var(--radius-lg)" testId="sidebar-hide"
            image "symbol:icon.panelclose" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
        row padding="10px 16px" width=266 box-sizing="border-box"
          button press=openSearch appearance="none" aria-keyshortcuts="Meta+K Control+K" aria-label="Search the docs" testId="search-open"
            flex=1 display="flex" align-items="center" gap=8 height=36 box-sizing="border-box" padding="0 16px 0 8px" border="0.5px solid var(--color-border-default)" border-radius="var(--radius-full)" background-color="var(--color-background-default)" box-shadow="0 1px 1px rgba(0, 0, 0, 0.05), 0 1px 1.5px rgba(0, 0, 0, 0.03)"
            image "symbol:search" aria-hidden=true width="1.25rem" height="1.25rem" color="var(--color-icon-default)"
            text "Search" flex=1 text-align="left" font-size="var(--text-sm)" font-weight=500 line-height=1.4 color="var(--color-text-secondary)"
            text "⌘K" aria-hidden=true font-size="var(--text-sm)" font-weight=500 line-height=1.4 color="var(--color-text-quaternary)"
        row width=266 box-sizing="border-box"
          Tabs(nav=site, tab=tab, prefix="")
        scroll flex=1 min-height=0 min-width=266 box-sizing="border-box"
          Sidebar(nav=site, current=top(nav).name, tab=tab, toggled=navToggled, toggle=toggleNav, prefix="")
      column width=(sidebar ? "0px" : "calc(48px - clamp(0px, (960px - 100vw) * 1000, 48px))") -exact-layout-transition="220ms ease" flex-shrink=0 overflow="hidden" inert=(not wide or sidebar) padding-top=18 align-items="center" testId=(sidebar ? "sidebar-rail" : "sidebar-rail-shown") position="absolute" top=0 bottom=0 left=0
        button press=toggleSidebar appearance="none" aria-label="Show the sidebar" title="Show the sidebar" padding=6 border-radius="var(--radius-lg)" testId="sidebar-show"
          image "symbol:icon.panelopen" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
        button press=openSearch appearance="none" aria-keyshortcuts="Meta+K Control+K" aria-label="Search the docs" title="Search" padding=6 margin-top=8 border-radius="var(--radius-lg)" testId="search-rail"
          image "symbol:search" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
      if menu
        scroll id="site-menu" flex=1 min-width=0 background-color="var(--color-background-screen)" testId="site-menu" position="absolute" top="clamp(0px, (960px - 100vw) * 1000, 57px)" left=0 right=0 bottom=0
          row padding-top=10
            Tabs(nav=site, tab=tab, prefix="menu-")
          Sidebar(nav=site, current=top(nav).name, tab=tab, toggled=navToggled, toggle=toggleNav, prefix="menu-")
      dialog id="search" close=searchClosed closedby="any" aria-label="Search the docs" padding=0 margin=0 left="50%" transform="translate(-50%, -50%)"
        top="calc(45vh + clamp(0px, (789px - 100vw) * 1000, 5vh))" height="calc(75vh + clamp(0px, (789px - 100vw) * 1000, 21vh))" width="calc(max(40vw, 680px) + clamp(0px, (789px - 100vw) * 1000, max(0px, 96vw - max(40vw, 680px))) - clamp(0px, (789px - 100vw) * 1000, max(0px, max(40vw, 680px) - 96vw)))" max-width="none" max-height="none" overflow="hidden"
        border="1px solid var(--color-border-default)" border-radius=40 background-color="var(--color-background-default)" color="var(--color-text-default)" font-family="var(--font-sans)"
        if searchOpen
          column height="100%"
            row padding="0 16px" border-bottom="1px solid var(--color-border-secondary)"
              row position="relative" flex=1 align-items="center" margin="16px 0 12px"
                input id="search-input" role="combobox" aria-expanded=(hits.length > 0) aria-controls="search-hits"
                  aria-activedescendant=(match hits.at(chosen) { case some(h) => `search-hit-${h.id}`, case none => "" }) type="text" value=query input=ask key=searchKey placeholder="Search…" aria-label="Search the docs" testId="search-input"
                  flex=1 min-width=0 min-height=46 box-sizing="border-box" padding="0 40px" font-size="var(--text-base)" border="1px solid var(--color-border-default)" border-radius=24 outline="none" background-color="transparent" color="var(--color-text-default)"
                image "symbol:search" aria-hidden=true position="absolute" left=13 font-size="var(--text-base)" color="var(--color-icon-tertiary)"
                button press=clearOrClose appearance="none" aria-label=(query != "" ? "Clear search" : "Close search") position="absolute" right=9 padding=4 border-radius="var(--radius-full)" testId="search-close"
                  image "symbol:close" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-tertiary)"
            row height=2 flex-shrink=0
              if searching
                progress aria-label="Searching" flex=1 height=2 testId="search-loading"
            scroll flex=1 min-height=0 padding="0 16px 12px" overscroll-behavior="contain"
              if query.trim().length < 2
                text "Type at least two letters to search every page." padding="16px 8px" font-size="var(--text-sm)" color="var(--color-text-secondary)" testId="search-hint"
              else if hits.length == 0 and not searching
                text "No results found." padding="16px 8px" font-size="var(--text-sm)" color="var(--color-text-secondary)" testId="search-empty"
              else
                column id="search-hits" role="listbox" aria-label="Search results" gap=2
                  for h, i in hits key=h.id
                    link id=`search-hit-${h.id}` href=h.href role="option" aria-selected=(i == chosen) tabindex=-1 retainFocus=true display="block" padding=(h.nested ? "6px 10px 6px 42px" : "8px 10px") border-radius="var(--radius-lg)" background-color=(i == chosen ? "var(--color-background-element)" : "transparent") testId=`search-hit-${h.id}`
                      if h.nested
                        row align-items="center" gap=8
                          text "#" aria-hidden=true font-size="var(--text-xs)" color="var(--color-text-quaternary)"
                          text font-size="var(--text-xs)" color="var(--color-text-default)" min-width=0
                            Marked(parts=h.title)
                      else
                        row align-items="flex-start" gap=12
                          image "symbol:document" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)" margin-top=2
                          column gap=2 flex=1 min-width=0
                            text font-size="var(--text-sm)" font-weight=500 color="var(--color-text-default)"
                              Marked(parts=h.title)
                            if h.path != ""
                              text h.path font-size="var(--text-xs)" color="var(--color-text-quaternary)"
                            if h.snippet.length > 0
                              text font-size="var(--text-xs)" color="var(--color-text-secondary)" line-clamp=1
                                Marked(parts=h.snippet)
            row align-items="center" gap=16 height=44 flex-shrink=0 padding="0 24px" border-top="1px solid var(--color-border-secondary)"
              row align-items="center" gap=16 max-width="clamp(0px, (100vw - 768px) * 1000, 600px)" overflow-x="clip" min-width=0 margin-left=-1 white-space="nowrap" testId="search-keys"
                row align-items="center" gap=6 padding-left=1
                  text "↵" class=Key
                  text "to select" font-size="var(--text-xs)" color="var(--color-text-tertiary)"
                row align-items="center" gap=6
                  text "↑" class=Key
                  text "↓" class=Key
                  text "to navigate" font-size="var(--text-xs)" color="var(--color-text-tertiary)"
                row align-items="center" gap=6
                  text "esc" class=Key
                  text "to close" font-size="var(--text-xs)" color="var(--color-text-tertiary)"
              link href="https://www.algolia.com/developers/" aria-label="Search by Algolia" margin-left="auto" testId="search-attribution"
                row align-items="center" gap=6
                  text "Search by" font-size="var(--text-xs)" color="var(--color-text-tertiary)"
                  image "symbol:icon.algolia" aria-hidden=true width=62 height=14 color="var(--color-text-secondary)"

component Marked
  props
    parts: SearchPart[]
  view
    for p in parts key=p.id
      if p.mark
        text p.text color="var(--color-text-mark)" background-color="var(--color-background-mark)" border-radius=2
      else
        text p.text
