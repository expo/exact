routes nav
  tab home "/"
  tab explore "/explore"

shape Section
  filter: string
  items: string[]

component App
  state ordered = false
  action compare
    ordered = not ordered
  action pick(tab: string)
    nav = select(nav, tab)
  action follow(url: string)
    nav = go(nav, url)
  view
    main navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` position="absolute" inset=0
                if e.name == "explore"
                  Explore(shown=(nav.tab == "explore"), ordered=ordered)
                else
                  header
                    text "Home" role="heading" aria-level=1
                  button press=compare testId="compare"
                    text (ordered ? "Use independent history" : "Use ordered history")
      row role="tablist"
        for t in nav.tabs key=t.name
          button role="tab" aria-controls=`panel-${t.name}` aria-selected=(nav.tab == t.name) press=pick(t.name) testId=`tab-${t.name}`
            image (t.name == "home" ? "symbol:home" : "symbol:search")
            text (t.name == "home" ? "Home" : "Explore")

component Explore
  props
    shown: bool
    ordered: bool
  state filter = "Stocks"
  resource history = loadHistory(filter) with ordered when shown as shape Section else empty()
  resource rows = loadRows(filter) when shown as shape Section else empty()
  action switchFilter
    filter = filter == "Stocks" ? "Lend" : "Stocks"
  view
    column
      text filter role="heading" aria-level=1
      button press=switchFilter testId="filter"
        text "Switch filter"
      if rows.filter == filter
        for item in rows.items key=item
          text item
      else if not failed(rows)
        text "Loading rows…"
      if failed(rows)
        text (rows.filter == filter ? "Refresh failed. Showing previous rows." : "Couldn’t load rows.")
      if history.filter == filter
        for item in history.items key=item
          text item
      if failed(history)
        text (history.filter == filter ? "Couldn’t update history." : "Couldn’t load history.")
