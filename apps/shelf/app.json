{
  "$schema": "../../scripts/app.schema.json",
  "name": "Shelf",
  "short_name": "Shelf",
  "id": "com.exact.shelf",
  "start_url": "/",
  "display": "standalone",
  "icons": [{ "src": "assets/icon.png", "purpose": "any maskable" }],
  "alternate_icons": [
    { "name": "Paper", "icons": [{ "src": "assets/icon-paper.png", "purpose": "any maskable" }] }
  ],
  "preload": {
    "discover": { "url": "https://openlibrary.org/subjects/science_fiction.json?limit=20" }
  },
  "shortcuts": [
    {
      "name": "Add Book",
      "url": "/add",
      "apple": {
        "symbol": "plus"
      }
    }
  ],
  "intents": {
    "entities": {
      "shelf": { "title": "Shelf", "search": false },
      "book": { "title": "Book", "within": "shelf" }
    },
    "tools": {
      "logPages": {
        "title": "Log Pages",
        "parameters": {
          "id": { "title": "Book", "entity": "book" },
          "page": { "title": "Page", "description": "The page you have read up to.", "type": "integer" }
        },
        "apple": { "phrases": ["Log pages in ${applicationName}"] }
      },
      "addToShelf": {
        "title": "Add to Shelf",
        "parameters": {
          "title": { "title": "Title" },
          "author": { "title": "Author" },
          "pages": { "title": "Pages", "description": "How many pages the book has.", "type": "integer" }
        }
      }
    }
  },
  "app": {
    "id": "com.exact.shelf",
    "name": "Shelf"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    },
    "windows": {
      "window": {
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 500
      }
    },
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0",
      "linux": "0",
      "windows": "0"
    }
  },
  "widgets": [
    {
      "kind": "library",
      "title": "Your Shelf",
      "description": "Your book count, and your latest addition or a book you choose.",
      "families": [
        "systemSmall",
        "accessoryRectangular"
      ],
      "component": "ShelfWidget",
      "props": "ShelfWidgetProps",
      "refresh": "widgetLibrary",
      "preview": {
        "count": 7,
        "latest": "The Dispossessed"
      },
      "configuration": {
        "title": "Your Shelf",
        "description": "Choose a book to keep in view.",
        "parameters": [
          { "name": "book", "title": "Book", "type": "entity", "entity": "book" }
        ]
      }
    },
    {
      "kind": "progress",
      "title": "Reading Progress",
      "description": "How far you are in a book from one of your shelves.",
      "families": ["systemSmall"],
      "component": "ProgressWidget",
      "props": "ProgressWidgetProps",
      "refresh": "widgetProgress",
      "preview": { "title": "Piranesi", "percent": 44 },
      "configuration": {
        "title": "Reading Progress",
        "description": "Choose a shelf, then a book on it.",
        "parameters": [
          { "name": "shelf", "type": "entity", "title": "Shelf", "entity": "shelf" },
          { "name": "book", "type": "entity", "title": "Book", "entity": "book" }
        ]
      }
    },
    {
      "kind": "cover",
      "title": "Book",
      "description": "The title and author of a book from one of your shelves.",
      "families": ["systemSmall"],
      "component": "CoverWidget",
      "props": "CoverWidgetProps",
      "refresh": "widgetCover",
      "preview": { "title": "Piranesi", "author": "Susanna Clarke" },
      "configuration": {
        "title": "Book",
        "description": "Choose a shelf, then a book on it.",
        "parameters": [
          { "name": "shelf", "type": "entity", "title": "Shelf", "entity": "shelf" },
          { "name": "book", "type": "entity", "title": "Book", "entity": "book" }
        ]
      }
    }
  ]
}
