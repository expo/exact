{
  "$schema": "../../scripts/app.schema.json",
  "name": "Geofence Fixture",
  "short_name": "Geofences",
  "id": "com.exact.geofencefixture",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.exact.geofencefixture",
    "name": "Geofence Fixture"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 480,
        "height": 640
      }
    },
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0",
      "linux": "0"
    }
  },
  "rust": { "data": { "crate": "geofence-fixture-data", "type": "geofence_fixture_data::Fences", "source": "geofence_fixture_data::Fences" } }
}
