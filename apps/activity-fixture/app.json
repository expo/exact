{
  "$schema": "../../scripts/app.schema.json",
  "name": "Activity Fixture",
  "short_name": "Activities",
  "id": "com.exact.activityfixture",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.exact.activityfixture",
    "name": "Activity Fixture"
  },
  "live_activities": [
    {
      "kind": "departure",
      "component": "FixtureActivity",
      "state": "FixtureState",
      "push": true,
      "preview": {
        "label": "Departs 9:05",
        "detail": null,
        "short": null,
        "at": null,
        "done": null
      },
      "android": {
        "title": "label",
        "text": "detail",
        "chip": "short",
        "when": "at",
        "progress": "done"
      }
    },
    {
      "kind": "alert",
      "component": "FixtureActivity",
      "state": "FixtureState",
      "frequent": true,
      "preview": {
        "label": "Delay",
        "detail": null,
        "short": null,
        "at": null,
        "done": null
      }
    }
  ],
  "controls": [
    {
      "kind": "depart",
      "title": "Start a departure",
      "symbol": "tram.fill",
      "tool": "startDeparture",
      "authentication": "always"
    },
    {
      "kind": "open",
      "title": "Activity fixture details",
      "symbol": "info.circle",
      "url": "/detail"
    },
    {
      "kind": "tally",
      "title": "Count a press",
      "symbol": "plus.circle",
      "tool": "tally",
      "authentication": "always"
    }
  ],
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 402,
        "height": 700,
        "minWidth": 320,
        "minHeight": 420
      }
    }
  },
  "deploy": {
    "store": {
      "macos": "0",
      "ios": "0"
    }
  },
  "rust": {
    "data": {
      "crate": "activity-fixture-data",
      "type": "activity_fixture_data::ActivityFixture",
      "source": "activity_fixture_data::ActivityFixture"
    }
  }
}
