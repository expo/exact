{
  "$schema": "../../scripts/app.schema.json",
  "name": "Photos Fixture",
  "short_name": "Photos",
  "id": "com.exact.photosfixture",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.exact.photosfixture",
    "name": "Photos Fixture"
  },
  "deploy": {
    "store": {
      "android": "0",
      "ios": "0",
      "macos": "0"
    }
  },
  "host": {
    "android": {
      "minimumOS": "10"
    },
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone"
      ]
    }
  },
  "rust": { "data": { "crate": "photos-fixture-data", "type": "photos_fixture_data::Fixture" } }
}
