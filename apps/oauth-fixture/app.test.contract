test "opens signed in and stays signed out after sign-out"
  signed-in "oauth.spec" {"clientId":"client-spec","sub":"reader-2","name":"Grace Hopper","token":"test-reader"}
  expect text "status" == "Signed in"
  expect text "name" == "Grace Hopper"
  reload
  expect text "name" == "Grace Hopper"
  tap "sign-out"
  clock data
  reload
  expect text "status" == "Signed out"

test "answers the first private read on a fresh launch"
  signed-in "oauth.spec" {"clientId":"client-spec","sub":"reader-3","token":"test-reader"}
  answer fetch "http://127.0.0.1:4400/p/spec/api/me" with 200 {"name":"Offline reader"}
  expect text "status" == "Signed in"
  expect text "name" == "Offline reader"

test "signs in, reads the person, and stays signed in after a relaunch"
  request POST "/control" {"action": "reset"}
  expect text "status" == "Signed out"
  tap "sign-in"
  authorize
  clock data
  expect text "status" == "Signed in"
  expect text "name" == "Ada Lovelace"
  reload
  clock data
  expect text "status" == "Signed in"
  expect text "name" == "Ada Lovelace"

test "signs out and revokes the session"
  request POST "/control" {"action": "reset"}
  expect text "status" == "Signed out"
  tap "sign-in"
  authorize
  clock data
  expect text "status" == "Signed in"
  tap "sign-out"
  clock data
  expect text "status" == "Signed out"
  request POST "/control" {"action": "expect", "profile": "spec", "least": {"revoke-current": 1}}

test "signs out when provider sign-out is requested without an endpoint"
  request POST "/control" {"action": "reset"}
  expect text "status" == "Signed out"
  tap "sign-in"
  authorize
  clock data
  expect text "status" == "Signed in"
  tap "end-session"
  clock data
  expect text "status" == "Signed out"
  request POST "/control" {"action": "expect", "profile": "spec", "least": {"revoke-current": 1}}

// LLP 1146 D8: the app's own sign-in screens, natively, where a fetch's
// `redirect: "manual"` answers the redirect and the app's `Cookie` is sent
test "with its own sign-in screens, it signs in to ForgeRock with no browser and stays signed in" on linux, macos, ios
  request POST "/control" {"action": "reset"}
  type "profile" "forgerock"
  clock data
  expect text "status" == "Signed out"
  tap "sign-in-here"
  clock data
  expect text "status" == "Signed in"
  expect text "name" == "Ada Lovelace"
  reload
  clock data
  expect text "status" == "Signed in"
