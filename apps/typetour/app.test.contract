always "each screen has a route"
  expect state screen in "lock" "home" "settings" "display" "messages" "thread" "notfound"

test "the phone visits its screens"
  clock settle
  tap "lock-unlock"
  clock settle
  tap "dock-settings"
  clock settle
  tap "row-display"
  clock settle
  tap "home-bar"
  clock settle
  tap "dock-messages"
  clock settle
  expect state current.url == "/messages"
  tap "conversation-nico"
  clock settle
  expect state current.url == "/messages/nico"
  tap "thread-back"
  clock settle
  expect state current.url == "/messages"
  tap "home-bar"
  tap "dock-settings"
  tap "row-app-lock"
  clock settle
  expect state current.url == "/"


test "the specimen returns to Settings"
  tap "lock-unlock"
  tap "app-typetour"
  tap "back-settings"
  expect state current.url == "/settings"
  tap "row-display"
  tap "specimen-later"
  expect state current.url == "/settings"
  tap "row-display"
  tap "specimen-install"
  expect state current.url == "/settings"

// An arrow at the text-size slider. On iOS it is the slider's accessibility
// increment or decrement, the call VoiceOver's swipe makes; on the web and
// Linux a keyboard's arrow. macOS is left out: its arrow is a keyboard's
// too, and a Mac with keyboard navigation off gives the slider no key.
test "an arrow moves the text size one step" on web, ios, linux
  tap "lock-unlock"
  tap "dock-settings"
  tap "row-display"
  type "text-size" key "ArrowRight"
  expect state scale == 1.01
  type "text-size" key "ArrowLeft"
  type "text-size" key "ArrowLeft"
  expect state scale == 0.99
