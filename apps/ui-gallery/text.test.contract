// The app opens on its first section (`start_url`), which a narrow window
// pushes over the list, so a test that chooses sections starts at the list
// (`at "/"`). A section's views are on screen only once it is chosen, so a
// test taps inside a section only after choosing it, and goes back to the
// list before choosing the next.

test "the app opens on its first section" on macos, ios
  clock settle
  expect tree has "intro-typography"

test "text styles and color samples are present and animate"
  at "/"
  tap "sidebar-typography"
  clock settle
  clock data
  expect tree has "text-styles"
  expect tree has "text-underlined"
  expect tree has "text-struck"
  expect tree has "text-mixed"
  expect tree has "text-half-alpha"
  expect tree has "text-transparent"
  expect tree has "text-sharp-shadow"
  expect tree has "text-blur-shadow"
  expect tree has "text-vibrant"
  expect tree has "text-wrapped"
  expect tree has "text-clamped"
  expect tree has "text-ellipsis"
  expect tree has "text-justified"
  expect tree has "text-combining"
  expect tree has "text-arabic"
  expect tree has "text-hebrew"
  expect tree has "text-devanagari"
  expect tree has "text-cjk"
  expect tree has "text-emoji"
  expect tree has "text-tall"
  expect text "text-changing" == "Original words"
  expect text "text-numeric" == "109.01"
  back
  clock settle
  tap "sidebar-textcolors"
  clock settle
  clock data
  expect tree has "text-color-srgb-red-light"
  expect tree has "text-color-display-p3-red-dark"
  expect tree has "text-color-oklch-red-light"
  back
  clock settle
  tap "sidebar-css"
  clock settle
  clock data
  expect tree has "srgb"
  back
  clock settle
  tap "sidebar-profiles"
  clock settle
  clock data
  back
  clock settle
  tap "sidebar-images"
  clock settle
  clock data
  expect tree has "pictures"
  back
  clock settle
  tap "sidebar-hdr"
  clock settle
  clock data
  back
  clock settle
  tap "sidebar-effects"
  clock settle
  clock data
  expect tree has "transition-toggle"
  back
  clock settle
  tap "sidebar-media"
  clock settle
  clock data
  expect tree has "canvas-p3"
  back
  clock settle
  tap "sidebar-menus"
  clock settle
  clock data
  expect tree has "lift-picked"
  back
  clock settle
  tap "sidebar-typography"
  clock settle
  clock data
  expect text "text-changing" == "Original words"
  expect text "text-numeric" == "109.01"
  tap "text-animate"
  clock settle
  expect text "text-changing" == "Changed words"
  expect text "text-numeric" == "128.90"
  tap "text-animate"
  clock settle
  expect text "text-changing" == "Original words"
  expect text "text-numeric" == "109.01"

test "HDR range choices stay enabled across native sections" on ios
  at "/"
  tap "sidebar-typography"
  clock settle
  clock data
  expect tree has "range-typography"
  expect text "range-typography-title" == "Dynamic range limit"
  expect tree missing "range-typography-note"
  expect state limit == "no-limit"
  back
  clock settle
  tap "sidebar-textcolors"
  clock settle
  clock data
  tap "range-textcolors-standard"
  expect state limit == "standard"
  expect enabled "range-textcolors-no-limit"
  tap "range-textcolors-no-limit"
  expect state limit == "no-limit"
  back
  clock settle
  tap "sidebar-css"
  clock settle
  clock data
  expect state limit == "no-limit"
  tap "range-css-constrained"
  back
  clock settle
  tap "sidebar-profiles"
  clock settle
  clock data
  expect state limit == "constrained"
  tap "range-profiles-standard"
  back
  clock settle
  tap "sidebar-images"
  clock settle
  clock data
  expect state limit == "standard"
  back
  clock settle
  tap "sidebar-hdr"
  clock settle
  clock data
  expect tree missing "range-hdr"
  back
  clock settle
  tap "sidebar-effects"
  clock settle
  clock data
  expect state limit == "standard"
  back
  clock settle
  tap "sidebar-media"
  clock settle
  clock data
  expect state limit == "standard"
  tap "range-media-no-limit"
  back
  clock settle
  tap "sidebar-menus"
  clock settle
  clock data
  expect tree missing "range-menus"
  back
  clock settle
  tap "sidebar-typography"
  clock settle
  clock data
  expect state limit == "no-limit"
  expect enabled "range-typography-standard"
  tap "range-typography-standard"
  expect state limit == "standard"

test "the browser offers range choices only for HDR images" on web
  at "/"
  tap "sidebar-typography"
  clock settle
  clock data
  expect tree has "text-styles"
  expect tree missing "range-typography"
  back
  clock settle
  tap "sidebar-textcolors"
  clock settle
  clock data
  expect tree missing "range-textcolors"
  back
  clock settle
  tap "sidebar-css"
  clock settle
  clock data
  expect tree missing "range-css"
  back
  clock settle
  tap "sidebar-profiles"
  clock settle
  clock data
  expect tree missing "range-profiles"
  back
  clock settle
  tap "sidebar-images"
  clock settle
  clock data
  expect text "range-images-title" == "Dynamic range limit"
  expect tree missing "range-images-note"
  tap "range-images-standard"
  expect state limit == "standard"
  back
  clock settle
  tap "sidebar-hdr"
  clock settle
  clock data
  expect tree missing "range-hdr"
  back
  clock settle
  tap "sidebar-effects"
  clock settle
  clock data
  expect tree missing "range-effects"
  back
  clock settle
  tap "sidebar-media"
  clock settle
  clock data
  expect tree missing "range-media"
  back
  clock settle
  tap "sidebar-images"
  clock settle
  clock data
  expect state limit == "standard"
  tap "range-images-no-limit"
  expect state limit == "no-limit"
  back
  clock settle
  tap "sidebar-menus"
  clock settle
  clock data
  expect tree missing "range-menus"
