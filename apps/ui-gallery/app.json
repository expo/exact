{
  "$schema": "../../scripts/app.schema.json",
  "name": "UI Gallery",
  "short_name": "UI Gallery",
  "version": "0.1.1",
  "buildNumber": 22,
  "id": "com.exact.uigallery",
  "start_url": "/",
  "display": "standalone",
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }
  ],
  "app": {
    "id": "com.exact.uigallery",
    "name": "UI Gallery"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 960,
        "height": 900,
        "minWidth": 320,
        "minHeight": 420
      }
    },
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0"
    }
  },
  "hatches": {
    "sidebar-list": ["ios"],
    "sticky-limit": ["ios", "tvos", "macos", "web", "linux", "windows", "android"],
    "hdr-probe": ["ios", "tvos", "macos", "web", "linux", "windows", "android"],
    "hdr-reference": ["ios", "tvos", "macos", "web", "linux", "windows", "android"]
  },
  "data": [
    "kind",
    "limit"
  ]
}
